			local function iconName(name)
				name = tostring(name or ""):lower()
				if iconPaths[name] then
					return name
				end
				if name:find("box") then
					return "box"
				end
				if name:find("chams") or name:find("glove") then
					return "palette"
				end
				if name:find("info") then
					return "person"
				end
				if name:find("lines") then
					return "target"
				end
				if name:find("visual") or name:find("esp") or name:find("spark") then
					return "eye"
				end
				if name:find("aim") or name:find("trigger") or name:find("crosshair") then
					return "target"
				end
				if name:find("sound") then
					return "sound"
				end
				if name:find("cam") or name:find("viewmodel") or name:find("third person") then
					return "camera"
				end
				if name:find("char") or name:find("agent") then
					return "person"
				end
				if name:find("skin") or name:find("color") then
					return "palette"
				end
				if name:find("config") then
					return "folder"
				end
				if name:find("world") or name:find("sky") or name:find("fog") then
					return "globe"
				end
				if name:find("box") then
					return "box"
				end
				if name:find("rage") then
					return "flame"
				end
				if name:find("bunny") or name:find("strafe") or name:find("move") then
					return "move"
				end
				return "settings"
