			}, root)
			round(card, 10)
			node("UIStroke", {Color = Color3.fromRGB(60, 60, 60), Thickness = 1}, card)
			local icon = node("Frame", {
				BackgroundColor3 = Color3.fromRGB(41, 41, 41),
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(12, 16),
				Size = UDim2.fromOffset(32, 32),
			}, card)
			round(icon, 8)
			local ring = node("Frame", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(8, 8),
				Size = UDim2.fromOffset(16, 16)
			}, icon)
			round(ring, 8)
			node("UIStroke", {Color = accent, Thickness = 1}, ring)
			for _, spec in ipairs({{14, 5, 2, 8}, {14, 19, 2, 8}, {5, 14, 8, 2}, {19, 14, 8, 2}}) do
				node("Frame", {
					BorderSizePixel = 0,
					BackgroundColor3 = accent,
					Position = UDim2.fromOffset(spec[1], spec[2]),
					Size = UDim2.fromOffset(spec[3], spec[4]),
				}, icon)
			end
			node("TextLabel", {
				BackgroundTransparency = 1,
				Text = kind,
				Font = Enum.Font.GothamMedium,
				TextSize = 12,
				TextColor3 = Color3.fromRGB(238, 238, 238),
				TextXAlignment = Enum.TextXAlignment.Left,
				Position = UDim2.fromOffset(56, 12),
				Size = UDim2.new(1, -68, 0, 16),
			}, card)
			node("TextLabel", {
				BackgroundTransparency = 1,
				Text = text,
				Font = Enum.Font.Gotham,
				TextSize = 11,
				TextColor3 = Color3.fromRGB(180, 180, 180),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Position = UDim2.fromOffset(56, 30),
				Size = UDim2.new(1, -68, 0, 24),
			}, card)
			local progress = node("Frame", {
				BorderSizePixel = 0,
				BackgroundColor3 = accent,
				Position = UDim2.new(0, 12, 1, -4),
				Size = UDim2.new(1, -24, 0, 2),
			}, card)
			table.insert(entries, 1, {
				card = card,
				bar = progress,
				at = os.clock(),
				duration = math.clamp(tonumber(settings.hitLogTime) or 4, 1, 10),
			})
			while #entries > math.clamp(tonumber(settings.hitLogMax) or 4, 1, 6) do
				local entry = table.remove(entries)
				entry.card:Destroy()
			end
			layout()
			tween(card, {GroupTransparency = 0}, 0.18)
		end
		lifecycle.connect(game:GetService("RunService").RenderStepped, function()
			local settings = readSettings() or {}
			local dirty = false
			for index = #entries, 1, -1 do
				local entry = entries[index]
				local age = os.clock() - entry.at
				local remaining = math.clamp(1 - age / entry.duration, 0, 1)
				entry.bar.Size = UDim2.new(remaining, -24 * remaining, 0, 2)
				entry.card.GroupTransparency = math.max(math.clamp(1 - age / 0.18, 0, 1), math.clamp((age - entry.duration + 0.25) / 0.25, 0, 1))
				if age >= entry.duration then
					entry.card:Destroy()
					table.remove(entries, index)
					dirty = true
				end
			end
			if dirty then
				layout()
			end
		end)
		function api:Relayout()
			layout()
		end
		lifecycle.onUnload(function()
			alive = false
			api:Clear()
			root:Destroy()
		end)
		api.Root = root
		api.Entries = entries
		return api
	end
