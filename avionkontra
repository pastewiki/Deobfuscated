		end
		local function layout()
			local settings = readSettings() or {}
			for index, entry in ipairs(entries) do
				local bottom = settings.hitLogPosition == "Bottom center"
				entry.card.AnchorPoint = bottom and Vector2.new(0.5, 1) or Vector2.new(1, 0)
				tween(entry.card, {
					Position = bottom and UDim2.new(0.5, 0, 1, -64 - (index - 1) * 72) or UDim2.new(1, -24, 0, 88 + (index - 1) * 72),
				}, 0.22)
			end
		end
		local api = {}
		function api:Clear()
