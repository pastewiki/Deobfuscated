			local settings = readSettings() or {}
			local text = tostring(message or "")
			local kind = text:lower():match("^killed") and "Eliminated" or text:lower():match("^missed") and "Missed shot" or "Hit confirmed"
			local accent = color or Color3.fromRGB(220, 220, 220)
			local card = node("CanvasGroup", {
