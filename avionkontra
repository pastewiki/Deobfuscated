			local function drawIcon(parent, name, size, color)
				local spec = iconPaths[iconName(name)]
				local frame = new("Frame", {Name = "AxionVectorIcon", BackgroundTransparency = 1, Size = UDim2.fromOffset(size, size)}, parent)
				local function line(x1, y1, x2, y2)
					local dx, dy = (x2 - x1) * size / 24, (y2 - y1) * size / 24
					local part = new("Frame", {
						BorderSizePixel = 0,
						BackgroundColor3 = color,
						AnchorPoint = Vector2.new(0.5, 0.5),
						Position = UDim2.fromScale((x1 + x2) / 48, (y1 + y2) / 48),
						Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), 1.5),
						Rotation = math.deg(math.atan2(dy, dx)),
					}, frame)
					corner(part, 1)
				end
				for _, p in ipairs(spec.lines or {}) do
					line(p[1], p[2], p[3], p[4])
				end
				for _, p in ipairs(spec.circles or {}) do
					local circle = new("Frame", {
						BackgroundTransparency = 1,
						AnchorPoint = Vector2.new(0.5, 0.5),
						Position = UDim2.fromScale(p[1] / 24, p[2] / 24),
						Size = UDim2.fromOffset(p[3] * size / 12, p[3] * size / 12),
					}, frame)
					corner(circle, 100)
					new("UIStroke", {Color = color, Thickness = 1.5}, circle)
				end
				return frame
			end
			local function tintIcon(frame, color)
				for _, part in ipairs(frame:GetDescendants()) do
					if part:IsA("UIStroke") then
						part.Color = color
					elseif part:IsA("Frame") and part.BackgroundTransparency ~= 1 then
						part.BackgroundColor3 = color
					end
				end
			end
