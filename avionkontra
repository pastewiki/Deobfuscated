			object.Parent = parent
			return object
		end
		local function tween(object, properties, duration)
			game:GetService("TweenService"):Create(object, TweenInfo.new(duration or 0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), properties):Play()
		end
		local function round(object, radius)
