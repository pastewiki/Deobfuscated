local soundMarks = {}
do
    local function note(pos, kind)
        if not S.soundEsp or hub.unloaded or typeof(pos) ~= "Vector3" then return end
        local char = localChar()
        if char and (char.Simulation.Position - pos).Magnitude < 7 then return end
        for _, e in pairs(Entities.GetAllCategoryEntities("Character")) do

            if (e.Health or 0) > 0 and not e.FogCulled and e.Position and (e.Position - pos).Magnitude < 7 then return end
        end
        local now = os.clock()
        local velocity = Vector3.zero
        for i = #soundMarks, 1, -1 do
            local m = soundMarks[i]
            local gap = now - m.at
            if gap < 1.2 and gap > 0.02 and (m.pos - pos).Magnitude < 14 then
                velocity = (pos - m.pos) / gap
                table.remove(soundMarks, i)
                break
            end
        end
        soundMarks[#soundMarks + 1] = { pos = pos, at = now, kind = kind, vel = velocity }
        while #soundMarks > 24 do table.remove(soundMarks, 1) end
    end

    local SM = M.SoundManager
    if type(SM) == "table" then

        local lastName
        swapWhen(function() return S.soundEsp end, SM, "Unpack", function(orig)
            return function(...)
                local name = orig(...)
                lastName = name
                return name
            end
        end)
        swapWhen(function() return S.soundEsp end, SM, "ResolveEntity", function(orig)
            return function(pos, ...)
                local src = debug.info(2, "s") or ""
                if src:find("Footsteps", 1, true) then
                    pcall(note, pos, "step")
                elseif type(lastName) == "string" and lastName:sub(1, 8) == "Weapons." then
                    pcall(note, pos, "shot")
                end
                lastName = nil
                return orig(pos, ...)
            end
        end)
    end
end

