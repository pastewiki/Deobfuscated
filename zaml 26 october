local function applySkybox()
    local existing = Lighting:FindFirstChild("ZamltraSky")
    if wrlSkybox then
        local s = SKYBOXES[wrlSkyboxType]
        if not (s and s.Bk) then return end
        local sky = existing or Instance.new("Sky")
        sky.Name = "ZamltraSky"
        sky.SkyboxBk, sky.SkyboxDn, sky.SkyboxFt = s.Bk, s.Dn, s.Ft
        sky.SkyboxLf, sky.SkyboxRt, sky.SkyboxUp = s.Lf, s.Rt, s.Up
        sky.Parent = Lighting
    elseif existing then
        existing:Destroy()
    end
end

