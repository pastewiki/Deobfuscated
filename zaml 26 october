local SAME_MATERIAL = {
    [Enum.Material.Wood] = 3, [Enum.Material.WoodPlanks] = 3, [Enum.Material.Cardboard] = 3,
    [Enum.Material.Plastic] = 2, [Enum.Material.SmoothPlastic] = 2,
}

local exitParams = RaycastParams.new()
exitParams.FilterType = Enum.RaycastFilterType.Include
exitParams.IgnoreWater = true
local function traceToExit(pos, dir, maxDist)
    exitParams.FilterDescendantsInstances = { mapGeometry }
    local steps = math.floor(maxDist / 0.2776) + 1
    local far = steps * 0.2776
    local enters, exits, exitHits = {}, {}, {}
    local at, n = 0.001, 0
    for _ = 1, 16 do
        local r = workspace:Raycast(pos + dir * at, dir * (far - at), exitParams)
        if not r then break end
        n = n + 1
        enters[n] = at + r.Distance
        at = enters[n] + 0.001
        if at >= far then break end
    end
    local back, m = far, 0
    for _ = 1, 16 do
        local r = back > 0.001 and workspace:Raycast(pos + dir * back, dir * -(back - 0.001), exitParams)
        if not r then break end
        m = m + 1
        exits[m] = back - r.Distance
        exitHits[m] = r
        back = exits[m] - 0.001
    end
    local ei, depth, hit = 1, 1, nil
    for i = 1, steps do
        local d = i * 0.2776
        while ei <= n and enters[ei] <= d do depth = depth + 1; ei = ei + 1 end
        while m >= 1 and exits[m] <= d do depth = depth - 1; hit = exitHits[m]; m = m - 1 end
        if depth <= 0 then break end
    end
    return (depth <= 0) and hit or nil
end

local function bulletDamage(weapon, origin, point, partName, allowWalls)
    local data = weapon.Data
    if not refreshMap() then return 0, 0 end
    local dir = point - origin
    local total = dir.Magnitude
    if total < 1e-3 then return 0, 0 end
    dir = dir / total
    if total > (data.Range or 0) then return 0, 0 end

    local falloff = GameCfg.Get("Weapon", "DistanceFallOff")
    local minStart = GameCfg.Get("Weapon", "MinimumPenetrationStartDistance")
    local maxPen = GameCfg.Get("Weapon", "MaxPenetrationDistance")
    local lossDiv = GameCfg.Get("Weapon", "PenetrationLossDivisor")
    local mults = data.HitboxMultipliers or GameCfg.Get("Damage", "HitboxMultipliers")

    local damage, pen = data.Damage, data.Penetration
    local pos, travelled, walls, left = origin, 0, 0, 4
    while damage > 0 do
        local rest = point - pos
        local r = workspace:Raycast(pos, rest, mapParams)
        if not r then
            travelled = travelled + rest.Magnitude
            return damage * data.RangeModifier ^ (travelled / falloff) * (mults[partName] or 1), walls
        end
        if not allowWalls or r.Instance.Name == "nowallbang" then return 0, walls end
        travelled = travelled + r.Distance
        local here = damage * data.RangeModifier ^ (travelled / falloff)
        local matIn, modIn = surfaceMod(r.Instance, r.Material)
        if left <= 0 or travelled > minStart or modIn < 0.1 or pen <= 0 then return 0, walls end
        local exit = traceToExit(r.Position, dir, maxPen)
        if not exit then return 0, walls end
        local matOut, modOut = surfaceMod(exit.Instance, exit.Material)
        local combined = (matIn == Enum.Material.Glass) and 3 or (modIn + modOut) / 2
        if matIn == matOut then combined = SAME_MATERIAL[matOut] or combined end
        local thick = (exit.Position - r.Position).Magnitude
        if (exit.Position - origin).Magnitude >= total then

            return 0, walls
        end
        local inv = 1 / combined
        local loss = here * ((matIn == Enum.Material.Glass) and 0.05 or 0.16)
            + math.max(0, 3 / pen * 1.25) * (inv * 3) + inv * thick * thick / lossDiv
        damage = here - math.max(0, loss)
        if damage < 1 then return 0, walls end
        pos = exit.Position
        walls, left = walls + 1, left - 1
    end
    return 0, walls
end

