            capturing = true
            keyLabel.Text = "..."
            keyLabel.TextColor3 = text
            keyStroke.Transparency = 0.1
            if captureConn then captureConn:Disconnect() end

            captureConn = hub.connect(UIS.InputBegan, function(input)
                local t = input.UserInputType
                if t == Enum.UserInputType.Keyboard then
                    if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
                        clearBind(name)
                    else
                        local kn = keyName(input)
                        if not kn then return end
                        setBind(name, kn, mode)
                    end
                elseif t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.MouseButton3 then
                    setBind(name, keyName(input), mode)
                else
                    return
                end
                stopCapture()
                showKey()
            end)
        end)

        local gui = popupGui()
        pop.Parent = gui
        activePopup = pop

        local function place()
            if not (target.Parent and pop.Parent) then closePopup(); return end
            local origin = gui.AbsolutePosition
            local view = gui.AbsoluteSize
            local a, sz = target.AbsolutePosition, target.AbsoluteSize
            local x = a.X + sz.X + 8
            if x + POP_W > origin.X + view.X - 4 then x = a.X - POP_W - 8 end
            local y = a.Y + (sz.Y - POP_H) / 2
            pop.Position = UDim2.fromOffset(x - origin.X, y - origin.Y)
        end
        place()
        followConn = hub.connect(RunService.RenderStepped, place)

        outside = hub.connect(UIS.InputBegan, function(input)
            if activePopup ~= pop then closePopup(); return end
            local t = input.UserInputType
            if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.MouseButton2 then return end
            if capturing and t == Enum.UserInputType.MouseButton2 then return end
            local p = mouseInGui()
            if not inside(pop, p) and not inside(menu, p) then closePopup() end
        end)
    end

    hub.connect(UIS.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton3 and hoveredName and not capturing then
