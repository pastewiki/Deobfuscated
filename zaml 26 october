        return Bullet.SpreadOffset(weapon, rng, weapon:GetInaccuracy(sim), weapon:GetSpread(), 1)
    end)
    weapon.AccuracyPenalty, weapon.RecoilIndex, weapon.Timer = ap, ri, timer
