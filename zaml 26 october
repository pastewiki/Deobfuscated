local function chooseAim(char, sim, weapon, dt, camLook)
    if not isGun(weapon) then return nil, false end
    local origin = eyePos(sim)

    if S.rage then
        tickState.scans = (tickState.scans or 0) + 1
        local t = rageScan(origin, weapon, camLook)
        if t then
            tickState.scanHits = (tickState.scanHits or 0) + 1
            t.at = os.clock()

            local id = t.entity.Identifier
            if tickState.seenId ~= id or t.at - (tickState.seenLast or 0) > 0.4 then
                tickState.seenId, tickState.seenSince = id, t.at
            end
            tickState.seenLast = t.at
            if t.ready then
                if (t.at - tickState.seenSince) * 1000 < S.rageReaction
                    or (t.at - (tickState.lastRageShot or 0)) * 1000 < S.rageShotDelay then
                    t.ready = false
                end
            end
            rageTarget = t

            return t, S.autoFire or userFiring()
        end
        return nil, false
    end

    local trigSilent = S.trigger and S.triggerSilent and S.silentAim and not S.rage
    local firing = userFiring() or tickState.forcedFire
    if S.silentAim and (firing or trigSilent) then
        local e, pos, part = legitTarget(origin)
        if e then
            if trigSilent and not firing then
                trigSince = trigSince or os.clock()
                if os.clock() - trigSince < S.triggerDelay / 1000 then return nil, false end
                local need = trigNeed(e, weapon, origin, pos, part)
                if need > 0 then
                    local raw = bulletDamage(weapon, origin, pos, part, S.triggerPen)
                    if raw <= 0 or afterArmor(e, weapon, raw, part) < need then return nil, false end
                end
                tickState.trigSilentWant = true
            end
            return { entity = e, pos = pos, part = part }, false
        elseif trigSilent then
            trigSince = nil
        end
    end
    return nil, false
end

local function antiAimAngles(sim, cmd, camYaw)
    local base = camYaw
    if S.aaBase == "At Target" then
        local origin, bestD = sim.Position, nil
        for _, e in pairs(Entities.GetAllCategoryEntities("Character")) do
            if targetable(e) and isEnemy(e) then
                local d = (e.Position - origin).Magnitude
                if not bestD or d < bestD then
                    bestD = d
                    local _, ry = dirToAngles((e.Position - origin).Unit)
                    base = ry
                end
            end
        end
    end
    local yaw = base
    local mode = S.aaYaw
    if mode == "Backward" then yaw = base + math.pi
    elseif mode == "Left" then yaw = base + math.pi / 2
    elseif mode == "Right" then yaw = base - math.pi / 2
    elseif mode == "Spin" then
        tickState.aaYaw = (tickState.aaYaw or base) + math.rad(S.aaSpin)
        yaw = tickState.aaYaw
    elseif mode == "Jitter" then
        local side = (cmd.ClientTick % 2 == 0) and 1 or -1
        yaw = base + math.pi + math.rad(S.aaJitter / 2) * side
    end
    if S.aaLeft then
        yaw = base + math.pi / 2
    elseif S.aaRight then
        yaw = base - math.pi / 2
    end
    local pitch
    if S.aaPitch == "Down" then pitch = PITCH_MAX
    elseif S.aaPitch == "Up" then pitch = -PITCH_MAX
    elseif S.aaPitch == "Zero" then pitch = 0 end
    return yaw, pitch
end

function hub.knifeTarget(char, sim, weapon, dt)
    local d = weapon and next(weapon) and weapon.Data
    if not (d and d.Type == "Melee") then return nil end

    local timer = weapon.Timer or (char and char.WeaponTimer) or 0
    if timer + dt < weapon.FireDelay - 1e-5 then return nil end
    local slashRange = GameCfg.Get("Weapon", "KnifeRangeLeftClick") or 3.3312
    local stabRange = GameCfg.Get("Weapon", "KnifeRangeRightClick") or 2.2208
    local origin = eyePos(sim)
    local best
    for _, e in pairs(Entities.GetAllCategoryEntities("Character")) do
        if targetable(e) and isEnemy(e) and not e.Culled then
            for _, name in ipairs({ "UpperTorso", "Head", "LowerTorso" }) do
                local pos = partPos(e, name)

                local dist = pos and (pos - origin).Magnitude - 0.9
                if dist and dist <= slashRange and (not best or dist < best.dist) and visible(origin, pos) then
                    best = { entity = e, pos = pos, part = name, dist = dist }
                end
            end
        end
    end
    if not best then return nil end
    local e = best.entity
    local root = e.CFrame or e.PrimaryPart.CFrame
    local to = (root.Position - sim.Position) * Vector3.new(1, 0, 1)
    local look = root.LookVector * Vector3.new(1, 0, 1)
    local back = to.Magnitude > 0 and look.Magnitude > 0 and to.Unit:Dot(look.Unit) > 0.475
    local hp = e.Health or 100
    local inStab = best.dist <= stabRange
    local slash = back and 90 or (timer > weapon.FireDelay + 0.4 and 40 or 25)
    local stab = back and 180 or 65
    local mode = S.knifeMode
    local key
    if mode == "Slash" then
        key = "WishFire"
    elseif mode == "Stab" then
        key = inStab and "WishFire2" or nil
    elseif slash >= hp then
        key = "WishFire"
    elseif inStab and (stab >= hp or back) then
        key = "WishFire2"
    else
        key = "WishFire"
    end
    if not key then return nil end
    best.knife = key
    return best
end

local function createMove(char, cmd)
    local sim = char.Simulation
    local weapon = WC.GetCurrentWeapon()
    local dt = tickDt()
    local camYaw, camPitch = dequantize(cmd.Yaw, cmd.Pitch)
    tickState.camYaw, tickState.camPitch = camYaw, camPitch
    tickState.aim = nil

    local add, inp = cmd.AdditionalInputs, cmd.Inputs
    local yaw, pitch = camYaw, camPitch

    local spaceHeld = add.Jump == true
        or (UserInputService:IsKeyDown(Enum.KeyCode.Space) and UserInputService:GetFocusedTextBox() == nil)
    local busy = sim.Planting or sim.Defusing or sim.Climbing or add.PressE or sim.Preparation

    local vel = sim.Velocity
    local speed = math.sqrt(vel.X * vel.X + vel.Z * vel.Z)
    local moveYaw = camYaw
    local grounded = sim.OnGround == true or sim.Climbing == true

    if S.longJump and grounded and speed > 6 and not busy and refreshMap() then

        local down = Vector3.new(0, -5, 0)
        local ahead = sim.Position + Vector3.new(vel.X, 0, vel.Z) * dt * 2
        if workspace:Raycast(sim.Position, down, mapParams) and not workspace:Raycast(ahead, down, mapParams) then
            add.Jump = true
            tickState.jumpTick = cmd.ClientTick
            tickState.longJumping = true
        end
    end
    if S.bhop and spaceHeld and not menuBlocked() then
        add.Jump = grounded
    end
    if add.Jump and grounded then tickState.jumpTick = cmd.ClientTick end
    if grounded and not add.Jump then tickState.longJumping = false end
    if (S.duckJump or tickState.longJumping) and not grounded
        and cmd.ClientTick - (tickState.jumpTick or -1000) <= S.airDuckTicks then
        add.Duck = true
    end

    local strafeWish
    if S.strafe and spaceHeld and not grounded and not busy then
        local mx = (inp.Right and 1 or 0) - (inp.Left and 1 or 0)
        local mz = (inp.Backward and 1 or 0) - (inp.Forward and 1 or 0)
        if S.strafeMode == "Legit" then
            local d = wrap(camYaw - (tickState.lastCamYaw or camYaw))
            if math.abs(d) > 1e-4 then
                inp.Forward, inp.Backward = false, false
                inp.Left, inp.Right = d > 0, d < 0
            end
        else

            local heading = camYaw + ((mx ~= 0 or mz ~= 0) and math.atan2(-mx, -mz) or 0)
            strafeWish = heading
            if speed > 2 then
                local velYaw = math.atan2(-vel.X, -vel.Z)
                local delta = wrap(heading - velYaw)
                local angle = math.pi / 2
                local side
                if math.abs(delta) > math.rad(S.alignThreshold) then
                    side = delta > 0 and 1 or -1
                    if S.fastTurn then

                        local c = sim.Constants
                        local wishSpeed = math.max(sim.CroppedMaxSpeed or c.Speed or 16, 1)
                        local budget = c.AirAcceleration * wishSpeed * dt
                        angle = math.acos(math.clamp((math.min(c.MaxAirStrafeSpeed, wishSpeed) - budget) / speed, -1, 1))
                    end
                else

                    tickState.strafeSide = -tickState.strafeSide
                    side = tickState.strafeSide
                end
                strafeWish = velYaw + side * angle
            end
        end
    end
    tickState.lastCamYaw = camYaw

    if S.aa and not busy and not (weapon and weapon.Data and weapon.Data.Type == "Bomb") then
        local aaYaw, aaPitch = antiAimAngles(sim, cmd, camYaw)
        yaw, pitch = aaYaw, aaPitch or pitch
    else
        tickState.aaYaw = nil
    end

    local camLook = anglesCF(-camPitch, camYaw).LookVector
    local aimNow, aimHoldNow
    if weapon and canFire(weapon, sim, dt, char) then
        local aim, hold = chooseAim(char, sim, weapon, dt, camLook)
        if aim then
            tickState.rageSeen = S.rage
            if S.autoStop and S.rage then

                strafeWish = nil
                add.Jump = false
                local wx, wz = 0, 0
                if grounded and speed > 2 then wx, wz = -vel.X / speed, -vel.Z / speed end
                local c2, s2 = math.cos(camYaw), math.sin(camYaw)
                local nx, nz = c2 * wx - s2 * wz, s2 * wx + c2 * wz
                inp.Right, inp.Left = nx > 0.3827, nx < -0.3827
                inp.Backward, inp.Forward = nz > 0.3827, nz < -0.3827
                moveYaw = camYaw
            end
            if aim.ready ~= false then
                aimNow, aimHoldNow = aim, hold
                tickState.lastAim = { pos = aim.pos, tick = cmd.ClientTick }
            end
        elseif S.noRecoil and (userFiring() or tickState.forcedFire) then
            local punch = SimCamera.DecayAimPunchAngle(punchOf(sim), sim.AimPunchAngleVel, dt)
            yaw, pitch = solveAngles(camLook, punch, 0, 0)
        end
    end

    if S.knifeBot and not aimNow and not busy then
        local kt = hub.knifeTarget(char, sim, weapon, dt)
        if kt then aimNow, aimHoldNow = kt, false end
    end

    local trackPos = aimNow and aimNow.pos
    local last = tickState.lastAim
    if not trackPos and last and (S.rage or S.silentAim) and cmd.ClientTick - last.tick <= 14 then
        trackPos = last.pos
    end
    if trackPos then
        local comp = S.noRecoil or (S.rage and S.rageRecoil) or (S.silentAim and not S.rage)
        local punch = comp and SimCamera.DecayAimPunchAngle(punchOf(sim), sim.AimPunchAngleVel, dt) or Vector3.zero
        yaw, pitch = solveAngles((trackPos - eyePos(sim)).Unit, punch, 0, 0)
    end

    do
        local prevYaw, prevPitch = tickState.sentYaw, tickState.sentPitch
        local steering = yaw ~= camYaw or pitch ~= camPitch
        local reached = true

        local limited = (S.rage and not S.rageInstant) or S.turnCamera
        if limited and prevYaw and (steering or tickState.sentOff) then
            local limit = math.rad(S.aimSpeed)
            local dy, dp = wrap(yaw - prevYaw), pitch - prevPitch
            local d = math.sqrt(dy * dy + dp * dp)

            local step = limit
            if S.aimSmooth > 0 then
                step = math.min(limit, math.max(d * (1 - S.aimSmooth / 100), math.rad(1.2)))
            end
            if d > step and S.aimSpeed < 180 then
                yaw, pitch = prevYaw + dy * step / d, prevPitch + dp * step / d
                reached = false
            end
        end
        tickState.sentYaw, tickState.sentPitch = yaw, pitch

        tickState.camWrite = (trackPos and S.turnCamera) and { yaw, pitch } or nil
        tickState.sentOff = math.abs(wrap(yaw - camYaw)) > 1e-4 or math.abs(pitch - camPitch) > 1e-4
        if aimNow and reached then
            tickState.aim = aimNow
            tickState.aimHold = aimHoldNow
        end
    end

    if strafeWish and not tickState.aim then

        local k = math.floor(wrap(strafeWish - yaw) / (math.pi / 4) + 0.5)
        local off = k * math.pi / 4
        yaw = strafeWish - off
        local bx, bz = -math.sin(off), -math.cos(off)
        inp.Right, inp.Left = bx > 0.38, bx < -0.38
        inp.Backward, inp.Forward = bz > 0.38, bz < -0.38
    elseif yaw ~= moveYaw then
        fixMovement(cmd, moveYaw, yaw)
    end
    if yaw ~= camYaw or pitch ~= camPitch then
        cmd.Yaw, cmd.Pitch = quantize(yaw, pitch)
    end
end

local GUARD_PARTS = {
    "Head", "LowerTorso", "UpperTorso", "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm",
    "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg", "LeftFoot", "RightFoot",
}

local GUARD_SPOTS = {
    Vector3.new(0, 0, 0), Vector3.new(0, 0.55, 0), Vector3.new(0, -0.55, 0),
    Vector3.new(0.55, 0, 0), Vector3.new(-0.55, 0, 0),
}
local function guardedPoint(e, origin, dir, sx, sy, onlyPart, aimPos)
    if not (e and e.Model and e.PrimaryPart) then return nil end

    local boxes = {}
    local fix = e.Culled and (e.CFrame * e.PrimaryPart.CFrame:Inverse()) or nil
    for _, name in ipairs(GUARD_PARTS) do
        local part = e.Model:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            boxes[#boxes + 1] = { cf = fix and (fix * part.CFrame) or part.CFrame, half = part.Size / 2, name = name }
        end
    end
    if #boxes == 0 then return nil end
    local rx, ry = dirToAngles(dir)
    local view = anglesCF(rx, ry)
    local offset = view.RightVector * sx + view.UpVector * sy
    local function onBody(point)
        for _, b in ipairs(boxes) do
            local lp = b.cf:PointToObjectSpace(point)
            if math.abs(lp.X) <= b.half.X * 0.9 and math.abs(lp.Y) <= b.half.Y * 0.9 and math.abs(lp.Z) <= b.half.Z + 0.6 then
                return true
            end
        end
        return false
    end

    if onlyPart and aimPos then
        local centre = aimPos - offset * (aimPos - origin).Magnitude
        if onBody(centre) then return aimPos, onlyPart end
    end
    for _, b in ipairs(boxes) do
        if not onlyPart or b.name == onlyPart then
            for _, spot in ipairs(GUARD_SPOTS) do
                local hit = b.cf:PointToWorldSpace(spot * b.half)
                local centre = hit - offset * (hit - origin).Magnitude
                if onBody(centre) then return hit, b.name end
            end
        end
    end
    return nil
end

