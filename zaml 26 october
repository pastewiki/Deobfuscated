local reapplyFov
do
    local MARK = 1e-6
    local req, wrote
    local zoomSens, zoomSensAt = 1, -math.huge
    local function zoomSensitivity()
        if os.clock() - zoomSensAt > 1 then
            zoomSensAt = os.clock()
            pcall(function()
                local v = M.Gui.GetComponent("Settings"):GetPlayerSettings().Controls.Sensitivity["Zoom Sensitivity"]
                if type(v) == "number" and v > 0 then zoomSens = v end
            end)
        end
        return zoomSens
    end

    local touchLook, zsIdx, zsOwned
    local function findZoomSens()
        local ok, fn = pcall(debug.getupvalue, M.CameraInput.AddTouchDelta, 1)
        if not ok or type(fn) ~= "function" then return end
        local want = zoomSensitivity()
        for i = 1, 12 do
            local okV, v = pcall(debug.getupvalue, fn, i)
            if not okV then break end
            if type(v) == "number" and math.abs(v - want) < 1e-6 then
                touchLook, zsIdx = fn, i
                return
            end
        end
    end
    local function setZoomSens(v)
        if not zsIdx then findZoomSens() end
        if zsIdx then pcall(debug.setupvalue, touchLook, zsIdx, v) end
    end

    local function slot()
        for i = 1, 6 do
            local ok, v = pcall(debug.getupvalue, CamCtl.SetFOVAmount, i)
            if not ok then return nil end
            if type(v) == "number" then return i, v end
        end
    end
    local idx
    local function step()
        if not idx then idx = slot() if not idx then return end end
        local cur = debug.getupvalue(CamCtl.SetFOVAmount, idx)
        if type(cur) ~= "number" then return end
        local base = CamCtl.GetSettingsFieldOfView()
        local fresh = cur ~= wrote
        if fresh then req = cur end
        local on = (S.fovChanger or S.noZoom) and not hub.unloaded

        if S.noZoom and not hub.unloaded and req < base - 0.01 then
            if not zsOwned then zoomSensitivity() end
            zsOwned = true
            setZoomSens(base / math.max(req, 1))
        elseif zsOwned then
            zsOwned = false
            zoomSensAt = -math.huge
            setZoomSens(zoomSensitivity())
        end
        if not on then
            if wrote and cur == wrote then
                debug.setupvalue(CamCtl.SetFOVAmount, idx, req)
                CamCtl.ApplyFov()
            end
            wrote = nil
            return
        end
        local zooming = req < base - 0.01
        local shown = req
        if zooming then
            if S.noZoom then
                shown = S.fovChanger and S.fovValue or base
            elseif S.fovChanger then

                shown = S.fovValue * req / base
            end
        elseif S.fovChanger then
            shown = S.fovValue
        end
        shown = shown + MARK
        if cur ~= shown then
            debug.setupvalue(CamCtl.SetFOVAmount, idx, shown)
            CamCtl.ApplyFov()
        end
        wrote = shown
    end
    reapplyFov = function() pcall(step) end
    hub.connect(RunService.RenderStepped, reapplyFov)
    local post = M.Tick.PostTick.Connect({ Priority = 3, SubPriority = 0.25, Function = reapplyFov })
    hub.onUnload(function()
        pcall(post.Disconnect)
        S.fovChanger, S.noZoom = false, false
        reapplyFov()
    end)
end

