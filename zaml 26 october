do
    local W = {
        fullbright = false,
        bright = false, brightness = 2, exposure = 0,
        fog = "Default", fogColor = Color3.fromRGB(190, 200, 220), fogStart = 0, fogEnd = 400,
        noPost = false,
        night = false, nightStrength = 0.6,
        asus = false, asusValue = 0.5, tint = false, tintColor = Color3.fromRGB(110, 90, 255), tintStrength = 0.5,
        weather = "Off", weatherAmount = 1,
    }
    local orig = {
        Brightness = Lighting.Brightness, Exposure = Lighting.ExposureCompensation,
        FogColor = Lighting.FogColor, FogStart = Lighting.FogStart, FogEnd = Lighting.FogEnd,
    }
    local WHITE = Color3.new(1, 1, 1)

    local grade = Instance.new("ColorCorrectionEffect")
    grade.Name = "ZamltraGrade"; grade.Enabled = false; grade.Parent = Camera
    local night = Instance.new("ColorCorrectionEffect")
    night.Name = "ZamltraNight"; night.Enabled = false; night.Parent = Camera
    local bloom = Instance.new("BloomEffect")
    bloom.Name = "ZamltraBloom"; bloom.Enabled = false; bloom.Parent = Camera

    local parkedAtmos = {}
    local function setFog(mode)
        W.fog = mode
        if mode == "Default" then
            for _, a in ipairs(parkedAtmos) do pcall(function() a.Parent = Lighting end) end
            parkedAtmos = {}
            Lighting.FogColor, Lighting.FogStart, Lighting.FogEnd = orig.FogColor, orig.FogStart, orig.FogEnd
        else
            for _, a in ipairs(Lighting:GetChildren()) do
                if a:IsA("Atmosphere") then
                    parkedAtmos[#parkedAtmos + 1] = a
                    a.Parent = nil
                end
            end
        end
    end

    local postSaved = {}
    local function sweepPost()
        for _, holder in ipairs({ Lighting, Camera }) do
            for _, fx in ipairs(holder:GetChildren()) do
                if fx:IsA("PostEffect") and fx.Name:sub(1, 8) ~= "Zamltra" then
                    if postSaved[fx] == nil then postSaved[fx] = fx.Enabled end
                    if fx.Enabled then fx.Enabled = false end
                end
            end
        end
    end
    local function restorePost()
        for fx, was in pairs(postSaved) do pcall(function() fx.Enabled = was end) end
        postSaved = {}
    end

    local mapSaved, mapGen, mapQueued = {}, 0, false
    local function mapActive() return W.asus or W.tint end
    local function applyMap()
        mapGen = mapGen + 1
        local gen = mapGen
        task.spawn(function()
            local skip = { [Camera] = true }
            for _, n in ipairs({ "Characters", "Debris" }) do
                local f = workspace:FindFirstChild(n)
                if f then skip[f] = true end
            end
            local count = 0
            local function visit(d)
                if not d:IsA("BasePart") or d:IsA("Terrain") then return end
                local o = mapSaved[d]
                if not o then
                    if not mapActive() then return end
                    o = { d.Transparency, d.Color }
                    mapSaved[d] = o
                end
                d.Transparency = (W.asus and o[1] < 1) and math.max(o[1], W.asusValue) or o[1]
                d.Color = W.tint and o[2]:Lerp(W.tintColor, W.tintStrength) or o[2]
            end
            for _, top in ipairs(workspace:GetChildren()) do
                if not skip[top] and not Players:GetPlayerFromCharacter(top) then
                    pcall(visit, top)
                    for _, d in ipairs(top:GetDescendants()) do
                        if gen ~= mapGen then return end
                        pcall(visit, d)
                        count = count + 1
                        if count % 2500 == 0 then task.wait() end
                    end
                end
            end
            if not mapActive() then mapSaved = {} end
        end)
    end

    local function queueMap()
        if mapQueued then return end
        mapQueued = true
        task.delay(0.3, function()
            mapQueued = false
            if not hub.unloaded then applyMap() end
        end)
    end

    local plate = Instance.new("Part")
    plate.Name = "ZamltraWeather"
    plate.Anchored, plate.CanCollide, plate.CanQuery, plate.CanTouch, plate.CastShadow = true, false, false, false, false
    plate.Transparency = 1
    plate.Size = Vector3.new(140, 1, 140)
    plate.Parent = fxFolder
    local emitter = Instance.new("ParticleEmitter")
    emitter.EmissionDirection = Enum.NormalId.Bottom
    emitter.Enabled = false
    emitter.Parent = plate

    local function setWeather()
        local mode, amount = W.weather, W.weatherAmount
        emitter.Enabled = mode ~= "Off"
        if mode == "Snow" then
            emitter.Rate = 350 * amount
            emitter.Lifetime = NumberRange.new(7, 9)
            emitter.Speed = NumberRange.new(8, 12)
            emitter.SpreadAngle = Vector2.new(12, 12)
            emitter.Acceleration = Vector3.new(1.5, 0, 0.5)
            emitter.Size = NumberSequence.new(0.22)
            emitter.Transparency = NumberSequence.new(0.15)
            emitter.Color = ColorSequence.new(WHITE)
            emitter.LightEmission = 0.6
            emitter.RotSpeed = NumberRange.new(-60, 60)
            pcall(function() emitter.Orientation = Enum.ParticleOrientation.FacingCamera end)
            pcall(function() emitter.Squash = NumberSequence.new(0) end)
        elseif mode == "Rain" then
            emitter.Rate = 1400 * amount
            emitter.Lifetime = NumberRange.new(0.8, 1)
            emitter.Speed = NumberRange.new(85, 95)
            emitter.SpreadAngle = Vector2.new(2, 2)
            emitter.Acceleration = Vector3.new(0, 0, 0)
            emitter.Size = NumberSequence.new(0.14)
            emitter.Transparency = NumberSequence.new(0.45)
            emitter.Color = ColorSequence.new(Color3.fromRGB(170, 195, 255))
            emitter.LightEmission = 0.3
            emitter.RotSpeed = NumberRange.new(0)
            pcall(function() emitter.Orientation = Enum.ParticleOrientation.VelocityParallel end)
            pcall(function() emitter.Squash = NumberSequence.new(6) end)
        end
    end

    local lastSweep, lastMap = 0, workspace:GetAttribute("Map")
    hub.connect(RunService.RenderStepped, function()
        if W.fullbright then
            Lighting.Ambient, Lighting.OutdoorAmbient = WHITE, WHITE
            Lighting.Brightness = 2
