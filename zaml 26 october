local PITCH_MAX = 1.55334

local function dirToAngles(d)
    return math.asin(math.clamp(d.Y, -1, 1)), math.atan2(-d.X, -d.Z)
end

local function anglesCF(rx, ry)
    return CFrame.fromEulerAnglesYXZ(rx, ry, 0)
end

local function quantize(yaw, pitch)
    local qy = math.clamp(math.round((wrap(yaw) + math.pi) / (2 * math.pi) * 65535), 0, 65535)
    local qp = math.clamp(math.round((math.clamp(pitch, -PITCH_MAX, PITCH_MAX) + PITCH_MAX) / (2 * PITCH_MAX) * 65535), 0, 65535)
    return qy, qp
end

local function dequantize(qy, qp)
    return -math.pi + qy * 2 * math.pi / 65535, -PITCH_MAX + qp * (2 * PITCH_MAX) / 65535
end

local function spreadSeed(tick)
    local x = bit32.bxor(tick, bit32.rshift(tick, 16))
    x = (x * 34283 % 65536 * 65536 + x * 51819) % 4294967296
    x = bit32.bxor(x, bit32.rshift(x, 13))
    x = (x * 49842 % 65536 * 65536 + x * 44597) % 4294967296
    x = bit32.bxor(x, bit32.rshift(x, 16))
    return bit32.band(x, 255) + 1
end

