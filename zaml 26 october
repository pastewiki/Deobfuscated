    function hub.connect(signal, fn)
        local c = signal:Connect(fn)
        local conns = hub.conns
        conns[#conns + 1] = c
        if #conns % 200 == 0 then
            local live = {}
            for _, x in ipairs(conns) do if x.Connected then live[#live + 1] = x end end
            hub.conns = live
        end
        if hub.unloaded then c:Disconnect() end
        return c
    end

    function hub.onUnload(fn)
        hub.cleanups[#hub.cleanups + 1] = fn
    end

    function hub.unload()
        if hub.unloaded then return end
        hub.unloaded = true
        for _, c in ipairs(hub.conns) do pcall(function() c:Disconnect() end) end
        hub.conns = {}
        for i = #hub.cleanups, 1, -1 do pcall(hub.cleanups[i]) end
        hub.cleanups = {}
        if type(env.zaml) == "table" and env.zaml.unload == hub.unload then env.zaml = nil end
    end
    env.__zamltraUnload = nil
    env.zaml = { unload = hub.unload }
