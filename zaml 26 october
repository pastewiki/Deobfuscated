local layoutScopeLines
do
    local scopeFrame
    local function getScope()
        if scopeFrame and scopeFrame.Parent then return scopeFrame end
        local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        local gui = pg and pg:FindFirstChild("GUI")
        local hudFrame = gui and gui:FindFirstChild("HUD")
        scopeFrame = hudFrame and hudFrame:FindFirstChild("Scope")
        return scopeFrame
    end

    local scopeLines = {}
    for i = 1, 4 do
        local line = Instance.new("Frame")
        line.BorderSizePixel = 0
        line.Visible = false
        line.Parent = overlay
        local grad = Instance.new("UIGradient")
        grad.Rotation = i <= 2 and 0 or 90
        grad.Parent = line
        scopeLines[i] = line
    end
    local SOLID = NumberSequence.new(0)
    local FADE_IN, FADE_OUT = NumberSequence.new(1, 0), NumberSequence.new(0, 1)
    function layoutScopeLines()
        local gradient = S.scopeStyle == "Gradient"
        local gap = gradient and S.scopeGap or 0
        local len = gradient and (S.scopeLen / 100) or 1
        local thick = gradient and S.scopeThick or 1
        local color = gradient and S.scopeColor or Color3.new(0, 0, 0)
        for i, line in ipairs(scopeLines) do
            local grad = line:FindFirstChildOfClass("UIGradient")
            line.BackgroundColor3 = color
            if i == 1 then
                line.AnchorPoint = Vector2.new(1, 0.5)
                line.Position = UDim2.new(0.5, -gap, 0.5, 0)
                line.Size = UDim2.new(0.5 * len, 0, 0, thick)
                grad.Transparency = gradient and FADE_IN or SOLID
            elseif i == 2 then
                line.AnchorPoint = Vector2.new(0, 0.5)
                line.Position = UDim2.new(0.5, gap, 0.5, 0)
                line.Size = UDim2.new(0.5 * len, 0, 0, thick)
                grad.Transparency = gradient and FADE_OUT or SOLID
            elseif i == 3 then
                line.AnchorPoint = Vector2.new(0.5, 1)
                line.Position = UDim2.new(0.5, 0, 0.5, -gap)
                line.Size = UDim2.new(0, thick, 0.5 * len, 0)
                grad.Transparency = gradient and FADE_IN or SOLID
            else
                line.AnchorPoint = Vector2.new(0.5, 0)
                line.Position = UDim2.new(0.5, 0, 0.5, gap)
                line.Size = UDim2.new(0, thick, 0.5 * len, 0)
                grad.Transparency = gradient and FADE_OUT or SOLID
            end
        end
    end
    layoutScopeLines()

    local hidden = {}
    local function restoreScope()
        for inst in pairs(hidden) do
            if inst.Parent then pcall(function() inst.Visible = true end) end
        end
        table.clear(hidden)
    end

    local function rifleScoped(w)
        local alt = w and next(w) and w.Data and w.Data.AltFunction
        return alt ~= nil and alt.Name == "ScopeRifle" and w.Mode == 2
    end
    local vmHiddenFor
    local function showViewmodel()
        local w = vmHiddenFor
        vmHiddenFor = nil
        if w then pcall(M.Viewmodel.SetVisible, w, not tp.active and (w.ZoomLevel or 0) == 0) end
    end
    hub.connect(RunService.RenderStepped, function()
        local sf = getScope()
        local weapon = WC.GetCurrentWeapon()
        local rifle = rifleScoped(weapon)
        local art = sf ~= nil and sf.Visible

        if (S.noBorders or tp.active) and art then
            for _, c in ipairs(sf:GetChildren()) do
                if c:IsA("GuiObject") and c.Visible then
                    hidden[c] = true
                    c.Visible = false
                end
            end
        elseif next(hidden) then
            restoreScope()
        end
        local hideVm = S.noBorders and rifle and not tp.active
        if hideVm and vmHiddenFor ~= weapon then
            showViewmodel()
            vmHiddenFor = weapon
            pcall(M.Viewmodel.SetVisible, weapon, false)
        elseif not hideVm and vmHiddenFor then
            showViewmodel()
        end
        local show = S.noBorders and (art or rifle)
        for _, line in ipairs(scopeLines) do line.Visible = show end
    end)
    hub.onUnload(restoreScope)
    hub.onUnload(showViewmodel)
end

do
    local STEP = "ZamltraThirdPerson"

    local function destroyBody()
        local ent = tp.ent
        tp.ent, tp.entId, tp.weaponKey = nil, nil, nil
        if ent then
            if tp.onRemove then pcall(tp.onRemove, ent) end
            pcall(function() ent:Destroy() end)
        end
    end

    local function buildBody(sim)
        local team = myTeam()
        local agent
        pcall(function()
            local loadout = HttpService:JSONDecode(LocalPlayer:GetAttribute("WeaponLoadout"))[team]
            agent = table.find(Enums.Items.Agents, loadout["15"].SkinName)
        end)
        local ok, ent = pcall(M.Character.new, sim.Identifier, {
            UserId = LocalPlayer.UserId, Team = table.find(Enums.Teams, team), Agent = agent,
        })
        if not ok or type(ent) ~= "table" or not ent.Model then
            tp.failed = true
            return
        end
        ent.Model.Parent = fxFolder
        tp.ent, tp.entId = ent, sim.Identifier

        if tp.onBody then pcall(tp.onBody, ent) end
    end

    local function updateBody(char, dt)
        local sim = char.Simulation
        if tp.ent and tp.entId ~= sim.Identifier then destroyBody() end
        if not tp.ent and not tp.failed then buildBody(sim) end
        local ent = tp.ent
        if not ent then return end

        local pos, prev = sim.Position, char.PreviousSimulation
        if prev and prev.Position and (prev.Position - pos).Magnitude < 5 then
            pos = prev.Position:Lerp(pos, math.clamp(M.Tick.GetAccumulatedTime() / tickDt(), 0, 1))
        end
        local yaw, pitch

        local sent = S.tpBody == "Sent Angles" or S.aa
        if sent then
            yaw, pitch = sim.Yaw, sim.Pitch
        else
            yaw, pitch = CamCtl.GetAngles()
        end
        if not (S.tpBodyRot or S.aa) then pitch = 0 end
        local snap = {
            Position = pos, Yaw = yaw, Pitch = pitch, AimPunchAngle = Vector3.zero,
            Ducked = sim.Ducked, Ducking = sim.Ducking, OnGround = sim.OnGround,
            Climbing = sim.Climbing, LadderNormal = sim.LadderNormal,
        }
        ent.Velocity = sim.Velocity
        ent:Interpolate(snap, snap, 1, 0, dt)

        ent.PrimaryPart:PivotTo(ent.CFrame)
        if ent.NameTag then ent.NameTag.Enabled = false end
        if ent.Model.Parent ~= fxFolder then ent.Model.Parent = fxFolder end

        local w = WC.GetCurrentWeapon()
        local key = (w and next(w)) and (w.Name .. "|" .. tostring(w.Skin)) or nil
        if key ~= tp.weaponKey then
            tp.weaponKey = key
            if key then
                local data = {
                    Name = w.Name, Skin = w.Skin, Slot = w.Slot, Mode = w.Mode or 1,
                    Ammo = w.Data.Ammo or 0, ReserveAmmo = w.Data.ReserveAmmo or 0,
                    Reloading = false, Firing = false, ZoomLevel = 0, Variant = 0,
                }
                ent.CharacterCurrentWeapon = data
                pcall(function() ent.CurrentWeaponChanged:Fire(data) end)
            end
        end
    end

    local function setActive(on, weapon)
        if on == tp.active then return end
        tp.active = on
        if not on then

            local ent = tp.ent
            if ent then
                pcall(function() ent.PrimaryPart:PivotTo(ent.CFrame + Vector3.new(0, -1000000, 0)) end)
            end
            pcall(function() Camera.CFrame = CamCtl.GetAppliedCFrame() end)
        end
    end

    RunService:BindToRenderStep(STEP, Enum.RenderPriority.Camera.Value + 10, function(dt)

        if setthreadidentity then pcall(setthreadidentity, 2) end
        local char = localChar()
        local weapon = WC.GetCurrentWeapon()
        local scoped = weapon and next(weapon) and (weapon.ZoomLevel or 0) > 0
        local want = S.tp and char ~= nil and CamCtl.GetTarget() == 1
        if not S.tp then tp.failed = false end
        if not char and tp.ent then destroyBody() end
        setActive(want and true or false, weapon)

        local vm = want and weapon and next(weapon) and weapon.Viewmodel or nil
        if vm ~= tp.vmModel or os.clock() - (tp.vmScan or 0) > 0.25 then
            tp.vmScan = os.clock()
            for part in pairs(tp.vmParts or {}) do
                if not (vm and part:IsDescendantOf(vm)) then pcall(function() part.LocalTransparencyModifier = 0 end) end
            end
            tp.vmModel, tp.vmParts = vm, {}
            if vm then
                for _, d in ipairs(vm:GetDescendants()) do
                    if d:IsA("BasePart") then tp.vmParts[d] = true end
                end
            end
        end
        for part in pairs(tp.vmParts) do part.LocalTransparencyModifier = 1 end
        if not want then return end

        local eye = CamCtl.GetAppliedCFrame()
        local goal = eye * CFrame.new(S.tpShoulder, S.tpHeight, S.tpDist)
        if S.tpCollide and refreshMap() then
            local from = eye.Position
            local d = goal.Position - from
            if d.Magnitude > 0.05 then
                local r = workspace:Spherecast(from, 0.4, d, mapParams)
                if r then goal = goal.Rotation + (from + d.Unit * math.max(r.Distance - 0.1, 0)) end
            end
        end
        Camera.CFrame = goal

        local ok, err = pcall(updateBody, char, dt)
        if not ok and not tp.warned then
            tp.warned = true
        end
    end)
    hub.onUnload(function()
        pcall(function() RunService:UnbindFromRenderStep(STEP) end)
        if setthreadidentity then pcall(setthreadidentity, 2) end
        setActive(false, WC.GetCurrentWeapon())
        for part in pairs(tp.vmParts or {}) do pcall(function() part.LocalTransparencyModifier = 0 end) end
        tp.vmParts = {}
        destroyBody()
        elevate()
    end)
end

