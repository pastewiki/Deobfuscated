function hub.shotCFrame(sim)
    local pa = punchOf(sim) * recoilScale()
    return CFrame.fromEulerAnglesYXZ(-sim.Pitch + math.rad(pa.X), sim.Yaw + math.rad(pa.Y), math.rad(pa.Z))
        + (sim.Position + Vector3.new(0, 1, 0) * (sim.CameraOffset + sim.Height))
end

local function onFired(weapon)
    hud.shots = hud.shots + 1
    local char = localChar()
    if not char or type(weapon) ~= "table" or not weapon.Data then return end
    local sim = char.Simulation

    local pred = tickState.pred
    tickState.pred = nil
    local sx, sy = 0, 0
    if weapon.Data.Type ~= "Melee" then
        pcall(function()
            local rng = M.Math.UniformRandomStream(spreadSeed(weapon.RandomSeed or 0))
            sx, sy = Bullet.SpreadOffset(weapon, rng, weapon:GetInaccuracy(sim), weapon:GetSpread(), 1)
            if pred then
                local err = math.sqrt((sx - pred[1]) ^ 2 + (sy - pred[2]) ^ 2)
                tickState.spreadChecks = (tickState.spreadChecks or 0) + 1
                tickState.spreadErrMax = math.max(tickState.spreadErrMax or 0, err)
                tickState.spreadSize = math.sqrt(sx * sx + sy * sy)
                if err < 1e-4 then tickState.spreadExact = (tickState.spreadExact or 0) + 1 end
            end
        end)
    end

    local cf = hub.shotCFrame(sim)
    local origin = cf.Position
    local dir = (cf.LookVector + cf.RightVector * sx + cf.UpVector * sy).Unit
    local aimed = tickState.aim
    if aimed and aimed.pos then

        local want = aimed.pos - origin
        if want.Magnitude > 0.1 then
            local err = math.deg(math.acos(math.clamp(want.Unit:Dot(dir), -1, 1)))
            tickState.aimShots = (tickState.aimShots or 0) + 1
            tickState.aimErrSum = (tickState.aimErrSum or 0) + err
            tickState.aimErrMax = math.max(tickState.aimErrMax or 0, err)
            tickState.aimErrLast = err
        end
    end
    local range = math.min(weapon.Data.Range or 300, 1200)
    local chars = workspace:FindFirstChild("Characters")
    local filter = {}
    if refreshMap() then filter[#filter + 1] = mapGeometry end
    if chars then filter[#filter + 1] = chars end
    trigParams.FilterDescendantsInstances = filter
    local r = workspace:Raycast(origin, dir * range, trigParams)
    local finish = r and r.Position or (origin + dir * range)
    local shot = { at = os.clock(), origin = origin, dir = dir, weapon = weapon, pos = finish, guard = tickState.shotGuard,
        air = sim.OnGround ~= true, comp = pred ~= nil }

    if aimed and aimed.damage and S.rage then
        shot.expect = string.format(" [aimed %s %d]", pend.part(aimed.part) or "?", math.floor(aimed.damage + 0.5))
    end
    if shot.comp then
        if shot.air then tickState.airShots = (tickState.airShots or 0) + 1
        else tickState.groundShots = (tickState.groundShots or 0) + 1 end
    end
    tickState.shotGuard = nil
    if r and chars and r.Instance:IsDescendantOf(chars) then
        local model = r.Instance
        while model and model.Parent ~= chars do model = model.Parent end
        shot.entity = model and Entities.GetEntity("Character", tonumber(model.Name))
        shot.part = r.Instance.Name

        if shot.entity and isEnemy(shot.entity) then
            tickState.clientHits = (tickState.clientHits or 0) + 1
            if shot.comp then
                if shot.air then tickState.airClient = (tickState.airClient or 0) + 1
                else tickState.groundClient = (tickState.groundClient or 0) + 1 end
            end
            if shot.guard == true then tickState.cHitG = (tickState.cHitG or 0) + 1
            elseif shot.guard == false then tickState.cHitU = (tickState.cHitU or 0) + 1 end
            if aimed then tickState.clientAimHits = (tickState.clientAimHits or 0) + 1 end
            local uid = shot.entity.UserId
            if uid and (shot.entity.Health or 0) > 0 then
                pend.list[#pend.list + 1] = {
                    userId = uid, name = entName(shot.entity), part = pend.part(shot.part),
                    deadline = shot.at + pend.window(), expect = shot.expect,
                }
                shot.pendUsers = { [uid] = true }
            end
        end
    end
    lastShot = shot
    applyGame(shot, gameShot)

    if weapon.Data.Type ~= "Melee" and (S.tracer or S.impact) then
        task.defer(function()
            if setthreadidentity then pcall(setthreadidentity, 8) end
            local onTarget = shot.entity ~= nil and isEnemy(shot.entity)
            local fin = shot.gameEnd or finish
            tickState.tracerLast = string.format("onTarget=%s onlyHits=%s from=%s gameEnd=%s len=%.2f",
                tostring(onTarget), tostring(S.tracerOnlyHits), tostring(S.tracerFrom), tostring(shot.gameEnd ~= nil),
                (fin - origin).Magnitude)
            if onTarget or not S.tracerOnlyHits then
                local ok, err = pcall(drawTracer, weapon, origin, fin, shot.gameEnd ~= nil or r ~= nil)
                if not ok then tickState.tracerErr = tostring(err) end
            end
        end)
    end
end

local function onHealth(userId, health)
    local before = hpSeen[userId]
    hpSeen[userId] = health
    if not before or not health or health >= before or userId == LocalPlayer.UserId then return end
    local shot = lastShot

    local pending
    for i, h in ipairs(pend.list) do
        if h.userId == userId then
            pending = table.remove(pend.list, i)
            break
        end
    end
    if not pending and os.clock() - shot.at > pend.window() then return end

    local e = Entities.GetCharacterByUserId(userId)
    local mine = pending ~= nil or (shot.entity ~= nil and shot.entity.UserId == userId)
    if not mine and e and e.Position and shot.dir then
        local to = (e.Position + Vector3.new(0, 2.5, 0)) - shot.origin
        mine = to.Magnitude > 0.1 and to.Unit:Dot(shot.dir) > 0.985
    end
    if not mine or (e and not isEnemy(e)) then return end

    local damage = before - math.max(health, 0)
    local lethal = health <= 0
    local base = (shot.weapon and shot.weapon.Data and shot.weapon.Data.Damage) or 30
    local head = (shot.entity and shot.part == "Head") or damage >= base * 2.2
    local name = (pending and pending.name) or pend.name(userId, e)
    local where = (pending and pending.part) or (head and "head" or "body")
    local pos = (shot.entity and shot.entity.UserId == userId) and shot.pos or (e and e.CFrame.Position + Vector3.new(0, 2.5, 0))
    hud.hits = hud.hits + 1
    if shot.comp and not shot.counted then
        if shot.air then tickState.airServer = (tickState.airServer or 0) + 1
        else tickState.groundServer = (tickState.groundServer or 0) + 1 end
    end
    if shot.guard == true and not shot.counted then tickState.sHitG = (tickState.sHitG or 0) + 1
    elseif shot.guard == false and not shot.counted then tickState.sHitU = (tickState.sHitU or 0) + 1 end
    shot.counted = true
    markers[#markers + 1] = { at = os.clock(), kill = lethal, damage = damage, pos = pos }
    if S.hitSound then playSound(S.hitSoundId, S.hitVolume) end
    if S.hitLogs then
        if lethal then
            logLine(string.format("killed %s - %s, %d dmg", name, where, damage), S.killColor)
        else
            logLine(string.format("hit %s in the %s for %d (%d left)", name, where,
                damage, math.max(0, health)), where == "head" and S.killColor or nil)
        end
    end
    if hitLog.onConfirm and e then pcall(hitLog.onConfirm, e, damage, lethal) end

    if lethal then
        if S.killSound then playSound(S.killSoundId, S.killVolume) end
        if S.killFx and pos then
            local ring = fxPart(Vector3.new(1, 1, 1), CFrame.new(pos), S.killFxColor, 0.7)
            ring.Shape = Enum.PartType.Ball
            ring.Transparency = 0.25
            TweenService:Create(ring, TweenInfo.new(0.7, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
                { Size = Vector3.new(11, 11, 11) }):Play()
        end
    end
end

