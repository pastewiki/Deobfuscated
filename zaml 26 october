local function trigNeed(e, weapon, origin, point, partName)
    local need = S.trigDmgOverride and S.trigMinDmgOverride or S.triggerMinDmg
    if need <= 0 then return 0 end
    need = math.min(need, e.Health or 100)
    local data = weapon.Data
    local mults = data.HitboxMultipliers or GameCfg.Get("Damage", "HitboxMultipliers")
    local best = data.Damage * data.RangeModifier ^ ((point - origin).Magnitude / GameCfg.Get("Weapon", "DistanceFallOff"))
        * (mults[partName] or 1)
    best = afterArmor(e, weapon, best, partName)
    if best < need then need = math.max(best - 0.5, 0.01) end
    return need
end

local function solveAngles(dir, punch, sx, sy)
    local rx, ry = dirToAngles(dir)
    if sx and (sx ~= 0 or sy ~= 0) then
        local k = math.sqrt(1 + sx * sx + sy * sy)
        for _ = 1, 3 do
            local cf = anglesCF(rx, ry)
            rx, ry = dirToAngles((dir * k - cf.RightVector * sx - cf.UpVector * sy).Unit)
        end
    end
    local scale = recoilScale()
    local px, py = math.rad(punch.X * scale), math.rad(punch.Y * scale)
    return ry - py, px - rx
end

local function fixMovement(cmd, oldYaw, newYaw)
    local inp = cmd.Inputs
    local mx = (inp.Right and 1 or 0) - (inp.Left and 1 or 0)
    local mz = (inp.Backward and 1 or 0) - (inp.Forward and 1 or 0)
    if mx == 0 and mz == 0 then return end
    local c, s = math.cos(oldYaw), math.sin(oldYaw)
    local wx, wz = mx * c + mz * s, -mx * s + mz * c
    local c2, s2 = math.cos(newYaw), math.sin(newYaw)
    local nx, nz = c2 * wx - s2 * wz, s2 * wx + c2 * wz
    local t = math.sqrt(nx * nx + nz * nz) * 0.3826834
    inp.Right, inp.Left = nx > t, nx < -t
    inp.Backward, inp.Forward = nz > t, nz < -t
end

local function isGun(weapon)
