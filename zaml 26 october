        root.Parent = overlay
        return { root = root, glow = glow, glowStroke = gs, bg = bg, track = track, halves = halves, icon = icon, text = text }
    end

    local function setRing(w, frac, color)
        frac = math.clamp(frac, 0, 1)

        w.halves[1].grad.Rotation = 180 * math.min(frac, 0.5) / 0.5
        w.halves[2].grad.Rotation = 180 + 180 * math.max(frac - 0.5, 0) / 0.5
        for _, h in ipairs(w.halves) do
            h.stroke.Color = color
            h.clip.Visible = true
        end
    end

    local function placeWidget(w, world)
        local vp = Camera.ViewportSize
        local sp, on = Camera:WorldToViewportPoint(world)
        local x, y = sp.X, sp.Y
        if not on or sp.Z < 0 then

            local cx, cy = vp.X / 2, vp.Y / 2
            local dx, dy = x - cx, y - cy
            if sp.Z < 0 then dx, dy = -dx, -dy end
            local a = math.atan2(dy, dx)
            x, y = cx + math.cos(a) * (cx - 44), cy + math.sin(a) * (cy - 44)
        end
        w.root.Position = UDim2.fromOffset(x, y)
    end

    local tracked = {}
    hub.nadeTracked = tracked
    local function forget(id)
        local g = tracked[id]
        if not g then return end
        tracked[id] = nil
        freePath(g.path)
        g.mark:Destroy()
        g.widget.root:Destroy()
        for _, d in pairs(g.discs) do d:Destroy() end
        for _, d in ipairs(g.area or {}) do d:Destroy() end
        if g.tinted then
            for inst, orig in pairs(g.tinted) do pcall(function() inst.Color = orig end) end
        end
    end
    hub.onUnload(function()
        for id in pairs(tracked) do forget(id) end
    end)

    local function plan(g, e, startTick, pos, vel)
        local tuning = e.Tuning
        local fuse = fuseOf(tuning)
        local r = rate()
        local left = fuse and (fuse - (startTick - g.launchTick) / r) or 6
        local state = newState(pos, vel, e)
        g.plan = fly(state, tuning, math.clamp(left + 0.25, 0.1, 6))
        g.planTick = startTick
        g.land = state.Position
        g.landNormal = state.RestNormal
        g.landVel = state.Velocity

        g.impactTick = state.Detonated and (startTick + #g.plan - 1) or nil
        g.plans = (g.plans or 0) + 1
    end

    local function velocityAt(a, b)
        local dtab = (b.Tick - a.Tick) / rate()
        if dtab <= 0 or dtab > 0.35 then return nil end
        local chord = (b.Snapshot.Position - a.Snapshot.Position) / dtab
        return chord - Vector3.new(0, gravityOf() * dtab / 2, 0)
    end

    local function follow(g, e)
        local sn = e.Snapshots
        if type(sn) ~= "table" or (sn.Count or 0) == 0 then return end
        local r = rate()
        local newest = sn:Newest()
        if not g.plan then

            local bf = 0
            pcall(function() bf = math.round((GameConfig.GetConfig().Grenade.LaunchBackfill or 0) * r) end)
            local first = sn:Get(1)
            local second = sn.Count > 1 and sn:Get(2) or nil
            local seeded = second and bf > 0 and math.abs((second.Tick - first.Tick) - bf) <= 1
            local launch = seeded and second or nil
            local s = launch and launch.Snapshot
            if s and typeof(s.InitialVelocity) == "Vector3" and (s.Phase or 0) == 0 and s.InitialVelocity.Magnitude > 0.01 then
                g.launchTick = launch.Tick
                plan(g, e, launch.Tick, s.Position, s.InitialVelocity)
            else
                g.launchTick = newest.Tick
                local prev = sn.Count > 1 and sn:Get(sn.Count - 1) or nil
                local v = prev and velocityAt(prev, newest) or Vector3.zero
                plan(g, e, newest.Tick, newest.Snapshot.Position, v)
            end
            g.checked = newest.Tick
            return
        end
        if newest.Tick == g.checked then return end
        g.checked = newest.Tick
        local k = newest.Tick - g.planTick + 1
        local expect = g.plan[math.clamp(k, 1, #g.plan)]
        if (expect - newest.Snapshot.Position).Magnitude > 1.5 then
            local prev = sn.Count > 1 and sn:Get(sn.Count - 1) or nil
            local v = prev and velocityAt(prev, newest) or Vector3.zero
            plan(g, e, newest.Tick, newest.Snapshot.Position, v)
        end
    end

    local function show(name) return S.nadeShow[name] == true end

    local function updateWidget(g, e, me, now)
        local w = g.widget
        if not S.nadeWarn or not g.launchTick then w.root.Visible = false return end
        local tuning = e.Tuning
        local fuse = fuseOf(tuning)
        local r = rate()
        local playhead = select(1, Entities.GetPlayheadTick()) or g.launchTick
        local left = fuse and math.max(fuse - (playhead - g.launchTick) / r, 0) or nil
        if left and g.impactTick then

            left = math.min(left, math.max((g.impactTick - playhead) / r, 0))
        end
        local land = g.land or e.Position
        local radius = (tuning and (tuning.Radius or tuning.CloudRadius)) or 10
        if e.GrenadeType == "Flash" then radius = math.min(radius, 60) end
        local danger = me and (land - me).Magnitude <= radius
        if danger and e.GrenadeType == "Flash" then danger = visible(me, land + Vector3.new(0, 0.5, 0)) end
        local color = danger and DANGER or S.nadeWarnColor
        local timed = left and e.GrenadeType ~= "Smoke" and e.GrenadeType ~= "Decoy"

        w.icon.Visible = show("Icon")
        w.icon.Image = iconOf(e.GrenadeType)
        w.icon.ImageColor3 = color
        w.glow.Visible = show("Glow")
        w.glowStroke.Color = color

        w.track.Color = color
        w.track.Transparency = 0.72
        w.bg.Visible = show("Icon") or show("Progress Bar")
        if show("Progress Bar") and timed then
            setRing(w, left / fuse, color)
        else
            w.halves[1].clip.Visible, w.halves[2].clip.Visible = false, false
        end
        local parts = {}
        if show("Text") then parts[#parts + 1] = SHORT[e.GrenadeType] or tostring(e.GrenadeType) end
        if show("Time Remaining") and timed then parts[#parts + 1] = string.format("%.1fs", left) end
        if show("Distance") and me then parts[#parts + 1] = math.floor((land - me).Magnitude * 0.28 + 0.5) .. "m" end
        w.text.Visible = #parts > 0
        w.text.Text = table.concat(parts, "  ")
        w.text.TextColor3 = color

        w.root.Visible = true
        w.bg.BackgroundTransparency = danger and (0.15 + 0.15 * math.sin(now * 12)) or 0.3
        placeWidget(w, S.nadeWarnAt == "Landing" and land or e.Position)
    end

    local function tint(g, inst, color)
        g.tinted = g.tinted or {}
        if inst:IsA("ParticleEmitter") then
            if g.tinted[inst] == nil then g.tinted[inst] = inst.Color end
            inst.Color = ColorSequence.new(color)
        elseif inst:IsA("Light") then
            if g.tinted[inst] == nil then g.tinted[inst] = inst.Color end
            inst.Color = color
        end
    end
    local function untint(g)
        if not g.tinted then return end
        for inst, orig in pairs(g.tinted) do pcall(function() inst.Color = orig end) end
        g.tinted = nil
    end

    local function afterBang(g, e)
        local discs = g.discs
        local used = {}
        if e.GrenadeType == "Smoke" and e.Smoke then

            g.hidden = g.hidden or {}
            for _, puff in ipairs(e.Smoke.Puffs or {}) do
                local em = puff.Emitter
                if em then
                    if S.noSmoke then
                        if g.hidden[em] == nil then g.hidden[em] = em.Transparency end
                        em.Transparency = NumberSequence.new(1)
                    elseif g.hidden[em] ~= nil then
                        em.Transparency = g.hidden[em]
                        g.hidden[em] = nil
                    end
                end
            end
        end
        if e.GrenadeType == "Smoke" and e.Smoke and not e.Ended then
            if S.smokeRadius then
                local d = discs.smoke or newDisc(Enum.Material.SmoothPlastic)
                discs.smoke = d
                local r = (e.Tuning and e.Tuning.CloudRadius) or 9
                local floor = workspace:Raycast(e.Position + Vector3.new(0, 1, 0), Vector3.new(0, -8, 0), mapParams)
                placeDisc(d, floor and floor.Position or e.Position, Vector3.yAxis, r, S.smokeRadiusColor, 0.6)
                used.smoke = true
            end
            if S.smokeTint then
                for _, puff in ipairs(e.Smoke.Puffs or {}) do
                    if puff.Emitter then tint(g, puff.Emitter, S.smokeTintColor) end
                end
            elseif g.tinted then untint(g) end
        elseif (e.GrenadeType == "Molotov" or e.GrenadeType == "Incendiary") and e.Fire and not e.Ended then
            local fr = 2
            pcall(function() fr = GameConfig.GetConfig().Inferno.FlameRadius or fr end)
            for i, f in pairs(e.Fire.Flames or {}) do
                if f.Burning then
                    if S.mollyRadius then
                        local key = "f" .. i
                        local d = discs[key] or newDisc(Enum.Material.SmoothPlastic)
                        discs[key] = d
                        placeDisc(d, f.Position, Vector3.yAxis, fr * 1.6, S.mollyRadiusColor, 0.55)
                        used[key] = true
                    end
                    if S.mollyTint and f.Part then
                        for _, x in ipairs(f.Part:GetDescendants()) do tint(g, x, S.mollyTintColor) end
                    end
                end
            end
            if not S.mollyTint and g.tinted then untint(g) end
        end
        for key, d in pairs(discs) do
            if not used[key] then d.Parent = nil end
        end
    end

    local recentHE = {}
    hub.connect(workspace.Terrain.ChildAdded, function(a)
        if not S.boomTint or hub.unloaded or a.Name ~= "GrenadeBurst" then return end
        task.defer(function()
            local near = false
            for _, p in ipairs(recentHE) do
                if (p - a.WorldPosition).Magnitude < 4 then near = true break end
            end
            if not near then return end
            for _, x in ipairs(a:GetDescendants()) do
                if x:IsA("ParticleEmitter") then x.Color = ColorSequence.new(S.boomTintColor)
                elseif x:IsA("Light") then x.Color = S.boomTintColor end
            end
        end)
    end)

    local function grenades(now)
        local char = localChar()
        local me = char and char.Simulation and eyePos(char.Simulation)
        local alive = {}
        local wantLive = S.nadeWarn or S.nadeThrown or S.smokeRadius or S.mollyRadius or S.smokeTint or S.mollyTint or S.boomTint
            or S.noSmoke
        if not wantLive then
            for id in pairs(tracked) do forget(id) end
            return
        end
        for _, e in pairs(Entities.GetAllCategoryEntities("Grenade")) do
            local id = e.Identifier
            if id and typeof(e.Position) == "Vector3" then
                alive[id] = true
                local g = tracked[id]
                if not g then
                    g = { path = newPath(), mark = newDisc(), widget = makeWidget(), discs = {}, area = {} }
                    g.widget.root.Visible = false
                    tracked[id] = g
                end
                if not e.Detonated then
                    follow(g, e)
                    if e.FogCulled then
                        g.widget.root.Visible = false
                    else
                        updateWidget(g, e, me, now)
                    end
                    if (S.nadeThrown or (S.nadeWarn and show("Trajectory"))) and g.plan and not e.FogCulled then
                        local playhead = select(1, Entities.GetPlayheadTick()) or g.planTick
                        drawPath(g.path, g.plan, math.floor(playhead - g.planTick) + 1, S.nadeColor)
                    else
                        hidePath(g.path)
                    end

                    if (S.nadeWarn or S.nadeThrown) and g.land and not e.FogCulled then
                        placeDisc(g.mark, g.land - (g.landNormal or Vector3.yAxis) * (GP.BoxSize.Y * 0.5),
                            g.landNormal, 0.6, S.nadeWarnColor, 0.2)
                        if S.nadeArea then
                            if g.areaFor ~= g.plans then
                                g.areaFor = g.plans
                                g.areaList = areaOf(e.GrenadeType, e.Tuning, g.land, g.landNormal or Vector3.yAxis, g.landVel)
                            end
                            drawArea(g.area, g.areaList or {}, AREA_COLOR[e.GrenadeType] or S.nadeWarnColor)
                        else
                            hideArea(g.area)
                        end
                    else
                        g.mark.Parent = nil
                        hideArea(g.area)
                    end
                else
                    if not g.banged then
                        g.banged = true
                        hidePath(g.path)
                        hideArea(g.area)
                        g.mark.Parent = nil
                        g.widget.root.Visible = false
                        if e.GrenadeType == "HE" then
                            table.insert(recentHE, e.Position)
                            task.delay(1, function() table.remove(recentHE, 1) end)
                        end
                    end
                    afterBang(g, e)
                end
            end
        end
        for id in pairs(tracked) do
            if not alive[id] then forget(id) end
        end
    end

    local flashOff, overlayOff
    local function removals()
        local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        local fb = pg and pg:FindFirstChild("Flashbang")
        if fb and fb:IsA("ScreenGui") then
            if S.noFlash and not hub.unloaded then
                if fb.Enabled then fb.Enabled = false end
                flashOff = fb
            elseif flashOff == fb then
                fb.Enabled = true
                flashOff = nil
            end
        end
        local ov = Camera and Camera:FindFirstChild("SmokeOverlay")
        local sg = ov and ov:FindFirstChildOfClass("SurfaceGui")
        if sg then
            if S.noSmoke and not hub.unloaded then
                if sg.Enabled then sg.Enabled = false end
                overlayOff = sg
            elseif overlayOff == sg then
                sg.Enabled = true
                overlayOff = nil
            end
        end
    end
    hub.onUnload(function() pcall(removals) end)

    local warned = false
    hub.connect(RunService.RenderStepped, function()
        if hub.unloaded then return end
        pcall(removals)
        if holder.Parent ~= fxFolder then holder.Parent = fxFolder end
        local ok, err = pcall(drawOwn)
        if not ok and not warned then
            warned = true
        end
        ok, err = pcall(grenades, os.clock())
        if not ok and not warned then
            warned = true
        end
    end)
end

local BONES = {
    { "Head", "UpperTorso" }, { "UpperTorso", "LowerTorso" },
    { "UpperTorso", "LeftUpperArm" }, { "LeftUpperArm", "LeftLowerArm" }, { "LeftLowerArm", "LeftHand" },
    { "UpperTorso", "RightUpperArm" }, { "RightUpperArm", "RightLowerArm" }, { "RightLowerArm", "RightHand" },
    { "LowerTorso", "LeftUpperLeg" }, { "LeftUpperLeg", "LeftLowerLeg" }, { "LeftLowerLeg", "LeftFoot" },
    { "LowerTorso", "RightUpperLeg" }, { "RightUpperLeg", "RightLowerLeg" }, { "RightLowerLeg", "RightFoot" },
}
local GREY = Color3.fromRGB(170, 170, 175)
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

local chamsFolder = Instance.new("Folder")
