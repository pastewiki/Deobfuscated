local function w2s(pos)
    local sp, on = Camera:WorldToViewportPoint(pos)
    return Vector2.new(sp.X, sp.Y), on, sp.Z
end

local function espColorFor(e, enemy, seen)
    if S.espColorMode == "Team Side" then
        return (e.Data and e.Data.Team == "CT") and S.ctColor or S.tColor
    elseif S.espColorMode == "Player Color" then
        local p = entPlayer(e)
        local c = p and p:GetAttribute("Color")
        if typeof(c) == "Color3" then return c end
    end
    if not enemy then return S.teamColor end
    if S.visCheck and seen then return S.visColor end
    return S.espColor
end

local function drawEntity(top, bottom, color, alpha, info)
    local a, onA, depth = w2s(top)
    local b, onB = w2s(bottom)
    local vp = Camera.ViewportSize
    if depth <= 0 or not (onA or onB) then
        if S.arrows and info.enemy then
            local rel = Camera.CFrame:PointToObjectSpace((top + bottom) / 2)
            local dir = Vector2.new(rel.X, -rel.Y)
            dir = (dir.Magnitude > 1e-3) and dir.Unit or Vector2.new(0, 1)
            local c = vp / 2 + dir * S.arrowRadius
            local side = Vector2.new(-dir.Y, dir.X)
            local tip = c + dir * S.arrowSize
            local l, r = c + side * S.arrowSize * 0.6, c - side * S.arrowSize * 0.6
            draw.line(tip, l, color, 2, alpha); draw.line(tip, r, color, 2, alpha); draw.line(l, r, color, 2, alpha)
        end
        return
    end

    local h = math.abs(b.Y - a.Y)
    if h < 2 then return end
    local w = h * 0.5
    local x, y = (a.X + b.X) / 2 - w / 2, math.min(a.Y, b.Y)
    local soft = 0.35 + alpha * 0.65

    if S.box then
        if S.boxStyle == "Corner" then
            local cw, ch = w * 0.28, h * 0.22
            for _, c in ipairs({ { x, y, 1, 1 }, { x + w, y, -1, 1 }, { x, y + h, 1, -1 }, { x + w, y + h, -1, -1 } }) do
                local pt = Vector2.new(c[1], c[2])
                draw.line(pt, pt + Vector2.new(cw * c[3], 0), color, 1, alpha)
                draw.line(pt, pt + Vector2.new(0, ch * c[4]), color, 1, alpha)
            end
            if S.boxFill then draw.rect(x, y, w, h, color, 0, 0.82 + alpha * 0.18) end
        else
            draw.rect(x - 1, y - 1, w + 2, h + 2, BLACK, 1, 1, soft)
            draw.rect(x, y, w, h, color, 1, S.boxFill and (0.82 + alpha * 0.18) or 1, alpha)
        end
    end

    if info.hp then
        local frac = math.clamp(info.hp / 100, 0, 1)
        if S.hpBar then
            draw.rect(x - 6, y - 1, 3, h + 2, BLACK, 0, soft)
            draw.rect(x - 5, y + h * (1 - frac), 1, h * frac, Color3.fromHSV(frac * 0.33, 0.9, 1), 0, alpha)
        end
        if S.hpNum then
            draw.text(tostring(math.floor(info.hp)), x - (S.hpBar and 9 or 4), y + h * (1 - frac) - 2,
                Color3.fromHSV(frac * 0.33, 0.6, 1), S.textSize - 2, 1, alpha)
        end
    end
    local armorShown = S.armorBar and info.armor and info.armor > 0
    if armorShown then
        local frac = math.clamp(info.armor / 100, 0, 1)
        draw.rect(x - 1, y + h + 2, w + 2, 3, BLACK, 0, soft)
        draw.rect(x, y + h + 3, w * frac, 1, Color3.fromRGB(90, 160, 255), 0, alpha)
    end

    local cx = x + w / 2
    if (S.names or info.forceName) and info.name then
        draw.text(info.name, cx, y - S.textSize - 3, WHITE, S.textSize, 0.5, alpha)
    end
    local below = y + h + (armorShown and 6 or 2)
    if S.weaponText and info.weapon then
        draw.text(info.weapon, cx, below, Color3.fromRGB(220, 220, 225), S.textSize - 1, 0.5, alpha)
        below = below + S.textSize
    end
    if S.distText and info.dist then
        draw.text(string.format("%dm", info.dist), cx, below, Color3.fromRGB(200, 200, 205), S.textSize - 1, 0.5, alpha)
        below = below + S.textSize
    end
    if info.note then
        draw.text(info.note, cx, below, GREY, S.textSize - 1, 0.5, alpha)
    end
    if S.flags and info.flags then
        for i, f in ipairs(info.flags) do
            draw.text(f[1], x + w + 4, y + (i - 1) * (S.textSize - 1), f[2], S.textSize - 2, 0, alpha)
        end
    end
    if S.snaplines and info.enemy then
        local from = (S.snapOrigin == "Top") and Vector2.new(vp.X / 2, 0)
            or (S.snapOrigin == "Center") and vp / 2 or Vector2.new(vp.X / 2, vp.Y)
        draw.line(from, Vector2.new(cx, y + h), color, 1, alpha)
    end
end

local function setChams(e, color, on, hp)
    local id = e.Identifier
    local h = chamsOf[id]
    if not on then
        if h then h.Enabled = false end
        return
    end
    if not h or h.Parent == nil then
        elevate()
        h = Instance.new("Highlight")
        h.Parent = chamsFolder
        chamsOf[id] = h
    end
    local mode = S.chamsMode
    local fill, outline = S.chamsFill, 0.1
    if mode == "Outline" then fill = 1
    elseif mode == "Solid" then fill, outline = 0, 1
    elseif mode == "Pulse" then fill = S.chamsFill + (1 - S.chamsFill) * (0.5 + 0.5 * math.sin(os.clock() * 4))
    elseif mode == "Rainbow" then color = Color3.fromHSV((os.clock() * 0.25) % 1, 0.85, 1)
    elseif mode == "Health" then color = Color3.fromHSV(math.clamp((hp or 100) / 100, 0, 1) * 0.33, 0.9, 1) end
    h.Adornee = e.Model
    h.Enabled = true
    h.DepthMode = S.chamsOccluded and Enum.HighlightDepthMode.Occluded or Enum.HighlightDepthMode.AlwaysOnTop
    h.FillColor, h.OutlineColor = color, color
    h.FillTransparency, h.OutlineTransparency = fill, outline
end

local leakFn, leakLookedAt = nil, 0
local function radarLeaks()
    if not leakFn and os.clock() - leakLookedAt > 5 then
        leakLookedAt = os.clock()
        local ok, found = pcall(filtergc, "function", { Name = "ApplyLeak" }, false)
        leakFn = ok and type(found) == "table" and found[1] or nil
    end
    if not leakFn then return nil end
    local ok, blips = pcall(debug.getupvalue, leakFn, 1)
    if not ok or type(blips) ~= "table" then return nil end
    local out = {}
    for id, blip in pairs(blips) do
        if type(blip) == "table" and typeof(blip.position) == "Vector3" then out[id] = blip.position end
    end
    return out
end

local function renderEsp(dt)
    local ents = Entities.GetAllCategoryEntities("Character")
    local leaks = (S.esp and S.radarEsp) and radarLeaks() or nil
    local camPos = Camera.CFrame.Position
    local now = os.clock()
    local present = {}
    local fadeStep = (S.espFade > 0) and dt / S.espFade or 1

    for id, e in pairs(ents) do
        if alive(e) then
            present[id] = true
            local enemy = isEnemy(e)
            local wanted = enemy or S.showTeam
            local show = (S.esp or S.nametags) and wanted
            local head = show and not e.FogCulled and partPos(e, "Head")
            local dist = head and (head - camPos).Magnitude
            local t = track[id]
            if head and dist <= S.espDist then
                if not t then t = { vis = 0 }; track[id] = t end
                local lf, rf = partPos(e, "LeftFoot"), partPos(e, "RightFoot")
                local footY = math.min(lf and lf.Y or head.Y - 4.6, rf and rf.Y or head.Y - 4.6) - 0.35
                local root = e.CFrame.Position
                local seen = S.visCheck and visible(camPos, head)
                local p = entPlayer(e)
                local flags
                if S.flags then
                    flags = {}
                    local armor = p and p:GetAttribute("ArmorValue") or 0
                    if armor > 0 then flags[#flags + 1] = { (p:GetAttribute("HasHelmet") and "HK" or "K"), Color3.fromRGB(150, 200, 255) } end
                    if p and p:GetAttribute("Cash") then flags[#flags + 1] = { "$" .. tostring(p:GetAttribute("Cash")), Color3.fromRGB(150, 230, 120) } end
                    if e.AnimationScoped then flags[#flags + 1] = { "ZOOM", Color3.fromRGB(255, 220, 110) } end
                    if p and p:GetAttribute("DefuseKit") then flags[#flags + 1] = { "KIT", Color3.fromRGB(120, 230, 160) } end
                    if e.Ducked then flags[#flags + 1] = { "DUCK", Color3.fromRGB(210, 210, 215) } end
                    if p and p:GetAttribute("SpawnProtected") then flags[#flags + 1] = { "IMMUNE", Color3.fromRGB(255, 240, 150) } end
                    if not p then flags[#flags + 1] = { "BOT", Color3.fromRGB(190, 190, 195) } end
                end
                local wpn = e.CharacterCurrentWeapon
                t.top = Vector3.new(root.X, head.Y + 0.75, root.Z)
                t.bottom = Vector3.new(root.X, footY, root.Z)
                t.color = espColorFor(e, enemy, seen)
                t.info = {
                    enemy = enemy, hp = e.Health, armor = p and p:GetAttribute("ArmorValue") or 0,
                    name = entName(e), weapon = wpn and wpn.Name, dist = math.floor(dist * 0.28), flags = flags,
                }
                t.live, t.fog, t.seenAt = true, false, now
                t.vis = math.min(1, t.vis + fadeStep)
                local alpha = 1 - t.vis

                if S.esp then
                    drawEntity(t.top, t.bottom, t.color, alpha, t.info)
                    if S.skeleton then
                        for _, bone in ipairs(BONES) do
                            local p1, p2 = partPos(e, bone[1]), partPos(e, bone[2])
                            if p1 and p2 then
                                local s1, on1 = w2s(p1)
                                local s2, on2 = w2s(p2)
                                if on1 and on2 then draw.line(s1, s2, t.color, 1, alpha) end
                            end
                        end
                    end
                    if S.headDot then
                        local sp, on = w2s(head)
                        if on then draw.rect(sp.X - 2, sp.Y - 2, 4, 4, t.color, 0, alpha) end
                    end
                elseif S.nametags then
                    local sp, on = w2s(t.top + Vector3.new(0, 0.4, 0))
                    if on then
                        draw.text(string.format("%s  %d", t.info.name, e.Health), sp.X, sp.Y - 14, enemy and S.espColor or S.teamColor, 14, 0.5, alpha)
                    end
                end
                setChams(e, t.color, S.esp and S.chams and not e.Culled, e.Health)
            else
                setChams(e, S.espColor, false)
                if t then t.fog = e.FogCulled == true and wanted end

                local leak = S.esp and wanted and enemy and leaks and leaks[id]
                if leak and (leak - camPos).Magnitude <= S.espDist then
                    t = t or { vis = 1 }
                    track[id] = t
                    t.top = leak + Vector3.new(0, 2.75, 0)
                    t.bottom = leak - Vector3.new(0, 2.6, 0)
                    t.color = espColorFor(e, true, false)
                    t.info = {
                        enemy = true, hp = e.Health, name = entName(e), forceName = true,
                        dist = math.floor((leak - camPos).Magnitude * 0.28), note = "radar",
                        weapon = e.CharacterCurrentWeapon and e.CharacterCurrentWeapon.Name,
                    }
                    t.live, t.fog, t.seenAt = true, true, now
                    drawEntity(t.top, t.bottom, t.color, 0.2, t.info)
                end
            end
        end
    end

    for id, t in pairs(track) do
        if t.live then
            t.live = false
        else
            local age = now - (t.seenAt or 0)
            if S.esp and S.dormant and present[id] and t.fog and age < S.dormantTime and t.top then
                local info = { enemy = t.info and t.info.enemy, name = t.info and t.info.name, forceName = true,
                    note = string.format("%.1fs ago", age) }
                drawEntity(t.top, t.bottom, GREY, 0.3 + 0.6 * age / S.dormantTime, info)
            else
                t.vis = t.vis - fadeStep
                if t.vis <= 0 or not t.top then
                    track[id] = nil
                elseif S.esp then
                    drawEntity(t.top, t.bottom, t.color, 1 - t.vis, t.info)
                end
            end
        end
    end

    for id, h in pairs(chamsOf) do
        if not present[id] then h:Destroy(); chamsOf[id] = nil end
    end

    if S.soundEsp then
        for i = #soundMarks, 1, -1 do
            local m = soundMarks[i]
            local age = now - m.at
            if age > S.soundLife then
                table.remove(soundMarks, i)
            else
                local alpha = age / S.soundLife
                local pos = m.pos + m.vel * math.min(age, 1)
                if S.soundBox then
                    drawEntity(pos + Vector3.new(0, 5.2, 0), pos - Vector3.new(0, 0.3, 0), S.soundColor, alpha,
                        { enemy = true, name = (m.kind == "shot") and "shot" or "step", forceName = true })
                else
                    local sp, on = w2s(pos)
                    if on then
                        local r = 6 + 10 * alpha
                        local prev
                        for k = 0, 16 do
                            local a = k / 16 * math.pi * 2
                            local pt = sp + Vector2.new(math.cos(a), math.sin(a)) * r
                            if prev then draw.line(prev, pt, S.soundColor, 1, alpha) end
                            prev = pt
                        end
                    end
                end
            end
        end
    end
end

