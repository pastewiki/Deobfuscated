    local function iconOf(kind)
        if icons[kind] == nil then
            local ok, id = pcall(function() return WeaponManager.Get(NAME[kind]).GuiInformation.Icon end)
            icons[kind] = (ok and id) and ("rbxassetid://" .. tostring(id)) or ""
        end
        return icons[kind]
    end

    local function rate()
        local ok, r = pcall(GameConfig.Get, "Game", "TickRate")
        return (ok and type(r) == "number" and r > 0) and r or 64
    end
    local function newState(pos, vel, e)
        return { Pitch = e and e.Pitch or 0, Yaw = e and e.Yaw or 0, AngularVelocity = Vector3.zero, IgnorePlayers = true,
                 Bounces = 0, Asleep = false, Position = pos, Velocity = vel }
    end

    local gravity
    local function gravityOf()
        if not gravity then
            local dt = 1 / rate()
            local st = newState(Vector3.new(0, 100000, 0), Vector3.zero)
            pcall(GP.Step, st, dt)
            gravity = math.max(-st.Velocity.Y / dt, 0)
        end
        return gravity
    end
    local function fuseOf(tuning)
        if not tuning then return nil end
        return (not tuning.CheckInterval and tuning.Fuse) or tuning.Timer
    end

    local function fly(state, tuning, seconds)
        local dt = 1 / rate()
        local minY = tuning and tuning.MinNormalY
        if minY then
            state.OnImpact = function(st, normal)
                if minY > normal.Y then return false end
                st.Detonated = true
                st.RestNormal = normal
                return true
            end
        end
        local points = { state.Position }
        for _ = 1, math.ceil(seconds / dt) do
            GP.Step(state, dt)
            points[#points + 1] = state.Position
            if state.Asleep or state.Detonated then break end
        end
        return points
    end

