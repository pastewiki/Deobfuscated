        local every = S.nadePrecise and 1 or 3
        local pts = {}
        for i = math.max(from or 1, 1), #points, every do pts[#pts + 1] = points[i] end
        if #points > 0 and pts[#pts] ~= points[#points] then pts[#pts + 1] = points[#points] end
        local width = 0.025 * S.nadeWidth
        local seq = ColorSequence.new(color)
        for i, p in ipairs(pts) do
            local a = path.atts[i]
            if not a then
                a = Instance.new("Attachment")
                a.Parent = holder
                path.atts[i] = a
            end
            a.WorldPosition = p
            if i > 1 then
                local b = path.beams[i - 1]
                if not b then
                    b = Instance.new("Beam")
                    b.Attachment0, b.Attachment1 = path.atts[i - 1], a
                    b.Segments, b.FaceCamera = 1, true
                    b.Parent = holder
                    path.beams[i - 1] = b
                end
                b.Color = seq
                b.Width0, b.Width1 = width, width

                b.LightEmission = math.clamp(S.nadeGlow / 100, 0, 1)
                b.Brightness = 1 + S.nadeGlow / 12
                b.Transparency = NumberSequence.new(0.1)
                b.Enabled = true
            end
        end
        for i = math.max(#pts, 1), path.shown do
            if path.beams[i] then path.beams[i].Enabled = false end
        end
        path.shown = math.max(#pts - 1, 0)
    end
    local function hidePath(path)
        for i = 1, path.shown do
            if path.beams[i] then path.beams[i].Enabled = false end
        end
        path.shown = 0
    end
    local function freePath(path)
        for _, b in pairs(path.beams) do b:Destroy() end
        for _, a in pairs(path.atts) do a:Destroy() end
    end
    local function newDisc(material)
        local p = Instance.new("Part")
        p.Shape = Enum.PartType.Cylinder
        p.Material = material or Enum.Material.Neon
        p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
        return p
    end
    local function placeDisc(disc, pos, normal, radius, color, transp)
        local n = normal or Vector3.yAxis
        disc.Size = Vector3.new(0.05, radius * 2, radius * 2)
        disc.CFrame = CFrame.lookAlong(pos + n * 0.06, n) * CFrame.Angles(0, math.pi / 2, 0)
        disc.Color = color
        disc.Transparency = transp
        if disc.Parent ~= holder then disc.Parent = holder end
    end

    local Inferno = M.Inferno
    local function fireReach(kind, pos, normal, vel)
        local reach
        pcall(function()
            local cfg = GameConfig.GetConfig()
            local tuning = cfg["Grenade" .. kind]
            local inf = Inferno.new(pos, normal, vel or Vector3.zero, function() return false end, tuning)
            if not inf then return end
            inf.Random = Random.new(7)
            inf:Step((cfg.Inferno.SpawnDuration or 3) + 0.2)
            local far = 0
            for _, f in ipairs(inf.Flames) do far = math.max(far, (f.Position - pos).Magnitude) end
            reach = far + (cfg.Inferno.FlameRadius or 4) * 0.6
        end)
        return reach
    end
    local function defaultReach(kind)
        local ok, r = pcall(function()
            local cfg = GameConfig.GetConfig()
            return (cfg["Grenade" .. kind].MaxRange or 10) * 0.8 + (cfg.Inferno.FlameRadius or 4) * 0.6
        end)
        return ok and r or 10
    end
    local aimFire = { kind = nil, pos = nil, at = 0, reach = nil }
    local AREA_COLOR = {
        HE = Color3.fromRGB(255, 80, 80), Smoke = Color3.fromRGB(180, 190, 210),
        Molotov = Color3.fromRGB(255, 120, 40), Incendiary = Color3.fromRGB(255, 120, 40),
    }
    local function areaOf(kind, tuning, pos, normal, vel)
        if kind == "HE" then
            return { { pos, (tuning and tuning.Radius) or 24 } }
        elseif kind == "Smoke" then
            return { { pos, (tuning and tuning.CloudRadius) or 9 } }
        elseif kind == "Molotov" or kind == "Incendiary" then
            return { { pos, fireReach(kind, pos, normal, vel) or defaultReach(kind) } }
        end
        return {}
    end

    local function aimedAreaOf(kind, tuning, pos, normal, vel)
        if kind ~= "Molotov" and kind ~= "Incendiary" then return areaOf(kind, tuning, pos, normal, vel) end
        local f = aimFire
        if f.kind ~= kind or not f.pos or ((f.pos - pos).Magnitude > 2 and os.clock() - f.at > 0.3) then
            f.kind, f.pos, f.at = kind, pos, os.clock()
            f.reach = fireReach(kind, pos, normal, vel) or defaultReach(kind)
        end
        return { { pos, f.reach } }
    end

    local function drawArea(pool, list, color)
        for i, a in ipairs(list) do
            local d = pool[i]
            if not d then
                d = newDisc(Enum.Material.Neon)
                pool[i] = d
            end
            placeDisc(d, a[1], Vector3.yAxis, a[2], color, 0.8)
        end
        for i = #list + 1, #pool do pool[i].Parent = nil end
    end
    local function hideArea(pool)
        for _, d in ipairs(pool) do d.Parent = nil end
    end

    local own = newPath()
    local ownMark = newDisc()
    local ownArea = {}
    hub.onUnload(function() for _, d in ipairs(ownArea) do d:Destroy() end end)
    local function drawOwn()
        local weapon = WC.GetCurrentWeapon()
        local char = localChar()
        local holding = S.nadePath and char and weapon and weapon.Data and weapon.Data.Type == "Grenade"
            and (weapon.PinPulled or not S.nadePinOnly)
        if not holding then
            if own.last then
                own.last = nil
                hidePath(own)
                ownMark.Parent = nil
                hideArea(ownArea)
            end
            return
        end
        local sim = char.Simulation
        local start, vel = GW.GetThrow(weapon.ThrowStrength, hub.shotCFrame(sim), sim.Velocity)
        local tuning = GameConfig.GetConfig()["Grenade" .. tostring(weapon.Data.GrenadeType)]

        local last = own.last
        local now = os.clock()
        local state
        if last and (now - last.at < 1 / 30 or ((last.start - start).Magnitude < 0.01 and (last.vel - vel).Magnitude < 0.01))
            and last.precise == S.nadePrecise then
            state = last.state
        else
            state = newState(start, vel)
            local points = fly(state, tuning, math.min(3.5, fuseOf(tuning) or 3.5))
            own.last = { at = now, start = start, vel = vel, state = state, precise = S.nadePrecise }
            drawPath(own, points, 1, S.nadeColor)
        end
        if state.Asleep or state.Detonated then
            placeDisc(ownMark, state.Position - (state.RestNormal or Vector3.yAxis) * (GP.BoxSize.Y * 0.5), state.RestNormal,
                0.6, S.nadeColor, 0.2)
        else
            ownMark.Parent = nil
        end

        if S.nadeArea then
            local kind = tostring(weapon.Data.GrenadeType)
            drawArea(ownArea, aimedAreaOf(kind, tuning, state.Position, state.RestNormal or Vector3.yAxis, state.Velocity),
                AREA_COLOR[kind] or S.nadeColor)
        else
            hideArea(ownArea)
        end
    end

