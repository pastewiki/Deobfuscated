VisualTab:Section({ Title = "character changer" })

do
    local CC = { on = false, target = "Self", source = nil, user = "", avatar = nil, avatarFor = nil, gen = 0,
        file = nil, custom = nil, customFor = nil }
    local CUSTOM_DIRS = { "zaml/characters", "Zamlblox/characters" }

    local R6 = {
        Torso = { "UpperTorso", CFrame.new(0, -0.2, 0) },
        ["Left Arm"] = { "LeftUpperArm", CFrame.new(0, -0.45, 0) },
        ["Right Arm"] = { "RightUpperArm", CFrame.new(0, -0.45, 0) },
        ["Left Leg"] = { "LeftUpperLeg", CFrame.new(0, -0.6, 0) },
        ["Right Leg"] = { "RightUpperLeg", CFrame.new(0, -0.6, 0) },
    }
    local dressed = {}
    local BODY = { Head = true, UpperTorso = true, LowerTorso = true, LeftUpperArm = true, LeftLowerArm = true,
        LeftHand = true, RightUpperArm = true, RightLowerArm = true, RightHand = true, LeftUpperLeg = true,
        LeftLowerLeg = true, LeftFoot = true, RightUpperLeg = true, RightLowerLeg = true, RightFoot = true }

    local agentNames = {}
    pcall(function()
        for _, name in pairs(Enums.Items.Agents) do
            if type(name) == "string" then agentNames[#agentNames + 1] = name end
        end
    end)
    table.sort(agentNames)
    local isAgent = {}
    for _, n in ipairs(agentNames) do isAgent[n] = true end
    CC.source = agentNames[1] or "Roblox Avatar"

    local agentTemplates, agentPending = {}, {}
    local function agentTemplate(name)
        if agentTemplates[name] or agentPending[name] then return agentTemplates[name] end
        agentPending[name] = true
        task.spawn(function()

            if setthreadidentity then pcall(setthreadidentity, 2) end
            local ok, model = pcall(M.CharacterModel.new, { Name = "ZtAgentTemplate", Agent = name, Parent = fxFolder })
            if ok and typeof(model) == "Instance" then
                model.Parent = nil
                agentTemplates[name] = model
            else
            end
        end)
        return nil
    end

    local function gameModel()
        return isAgent[CC.source] == true
    end

    local function template()
        if CC.source == "Roblox Avatar" then return CC.avatar end
        if CC.source == "Custom Model" then return CC.custom end
        return agentTemplate(CC.source)
    end

    local function sourceKey()
        if CC.source == "Roblox Avatar" then return "avatar:" .. tostring(CC.avatarFor) end
        if CC.source == "Custom Model" then return "custom:" .. tostring(CC.customFor) end
        return CC.source
    end

    local function undress(model)
        local d = dressed[model]
        if not d then return end
        dressed[model] = nil
        pcall(function() d.overlay:Destroy() end)
        for inst, t in pairs(d.hidden) do
            pcall(function() inst.Transparency = t end)
        end
    end

    local function undressAll()
        for model in pairs(dressed) do undress(model) end
    end

    local function hideRig(model, d)
        local keep = d.keep
        for _, inst in ipairs(model:GetDescendants()) do
            if (inst:IsA("BasePart") or inst:IsA("Decal") or inst:IsA("Texture")) and inst.Transparency < 1
                and not (keep and keep.Parent and inst:IsDescendantOf(keep)) then
                if d.hidden[inst] == nil then d.hidden[inst] = inst.Transparency end
                inst.Transparency = 1
            end
        end
    end

    local function dress(model, keep)
        local src = template()
        if not src then return end
        local overlay = src:Clone()
        overlay.Name = "ZtCharacterOverlay"

        for _, d in ipairs(overlay:GetDescendants()) do
            if d:IsA("Humanoid") and not gameModel() then

                pcall(function()
                    d.EvaluateStateMachine = false
                    d.RequiresNeck = false
                    d.BreakJointsOnDeath = false
                    d.PlatformStand = true
                    d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
                    d.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
                end)
            elseif d:IsA("Humanoid") or d:IsA("LuaSourceContainer") or d:IsA("AnimationController") or d:IsA("Animator")
                or d:IsA("BillboardGui") or d:IsA("Highlight") then
                d:Destroy()
            elseif d:IsA("Motor6D") then

                if d.Part1 == nil or BODY[d.Part1.Name] or d.Part1.Name == "HumanoidRootPart" then d:Destroy() end
            elseif d:IsA("BasePart") then
                d.Anchored, d.CanCollide, d.CanQuery, d.CanTouch = false, false, false, false
                d.Massless, d.CastShadow = true, false
            end
        end
        local ridesOn = {}
        for _, part in ipairs(overlay:GetChildren()) do
            if part:IsA("BasePart") then
                local r6 = R6[part.Name]
                local target = model:FindFirstChild((BODY[part.Name] and part.Name) or (r6 and r6[1]) or "")
                if target and target:IsA("BasePart") then
                    local offset = r6 and r6[2] or CFrame.new()
                    part.CFrame = target.CFrame * offset
                    local w = Instance.new("Weld")
                    w.Part0, w.Part1, w.C0 = target, part, offset
                    w.Parent = part
                    ridesOn[part] = { target, offset }
                else
                    part:Destroy()
                end
            end
        end

        for _, acc in ipairs(overlay:GetChildren()) do
            if acc:IsA("Accessory") then
                local handle = acc:FindFirstChild("Handle")
                local att = handle and handle:FindFirstChildOfClass("Attachment")
                local placed = false
                if att then
                    for body, ride in pairs(ridesOn) do
                        local mate = body:FindFirstChild(att.Name)
                        local target = mate and mate:IsA("Attachment") and ride[1]
                        if target then
                            for _, old in ipairs(handle:GetChildren()) do
                                if old:IsA("JointInstance") then old:Destroy() end
                            end
                            local offset = ride[2] * mate.CFrame * att.CFrame:Inverse()
                            handle.CFrame = target.CFrame * offset
                            local w = Instance.new("Weld")
                            w.Part0, w.Part1, w.C0 = target, handle, offset
                            w.Parent = handle
                            placed = true
                            break
                        end
                    end
                end
                if not placed then acc:Destroy() end
            end
        end

        local d = { key = sourceKey(), overlay = overlay, hidden = {}, keep = keep }
        hideRig(model, d)
        overlay.Parent = fxFolder
        dressed[model] = d
    end

    local function loadAvatar()
        CC.gen = CC.gen + 1
        local mine = CC.gen
        local who = (CC.user:gsub("^%s+", "")):gsub("%s+$", "")
        if CC.source ~= "Roblox Avatar" or who == "" then return end
        if CC.avatar and CC.avatarFor == who then return end
        CC.avatar, CC.avatarFor = nil, nil
        task.spawn(function()
            local ok, model = pcall(function()
                local id = tonumber(who) or Players:GetUserIdFromNameAsync(who)
                local desc = Players:GetHumanoidDescriptionFromUserId(id)
                desc.Head, desc.Torso, desc.LeftArm, desc.RightArm, desc.LeftLeg, desc.RightLeg = 0, 0, 0, 0, 0, 0
                desc.BodyTypeScale, desc.ProportionScale = 0, 0
                desc.HeightScale, desc.WidthScale, desc.DepthScale, desc.HeadScale = 1, 1, 1, 1
                return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
            end)
            if mine ~= CC.gen or hub.unloaded then return end
            if ok and model then
                CC.avatar, CC.avatarFor = model, who
            else
                elevate()
                pcall(function()
                    WindUI:Notify({ Title = "character changer", Content = "couldn't load an avatar for '" .. who .. "'", Duration = 4 })
                end)
            end
        end)
    end

    local filePaths = {}
    local function customFiles()
        local names = {}
        table.clear(filePaths)
        pcall(function()
            if isfolder and not isfolder(CUSTOM_DIRS[1]) then
                if not isfolder("zaml") then makefolder("zaml") end
                makefolder(CUSTOM_DIRS[1])
            end
        end)
        for _, dir in ipairs(CUSTOM_DIRS) do
            pcall(function()
                if not isfolder(dir) then return end
                for _, path in ipairs(listfiles(dir)) do
                    local name = path:match("([^/\\]+)$")
                    if name and name:lower():match("%.rbxmx?$") then
                        local label = (dir == CUSTOM_DIRS[1]) and name or ("zamlblox/" .. name)
                        filePaths[label] = dir .. "/" .. name
                        names[#names + 1] = label
                    end
                end
            end)
        end
        table.sort(names)
        if #names == 0 then names[1] = "(no files)" end
        return names
    end

    local function loadCustom()
        local file = CC.file
        if CC.source ~= "Custom Model" or not file or not filePaths[file] then return end
        if CC.custom and CC.customFor == file then return end
        CC.custom, CC.customFor = nil, nil
        local ok, objs = pcall(function()
            return game:GetObjects(getcustomasset(filePaths[file]))
        end)
        elevate()
        local model = ok and type(objs) == "table" and objs[1]

        if model and not model:IsA("Model") then model = model:FindFirstChildWhichIsA("Model", true) end

        if model then
            local base = filePaths[file]:match("^(.*)/") or ""
            for _, sm in ipairs(model:GetDescendants()) do
                if sm:IsA("SpecialMesh") then
                    local m, t = sm:FindFirstChild("ZamlMesh"), sm:FindFirstChild("ZamlTexture")
                    if m then pcall(function() sm.MeshId = getcustomasset(base .. "/" .. m.Value) end) m:Destroy() end
                    if t then pcall(function() sm.TextureId = getcustomasset(base .. "/" .. t.Value) end) t:Destroy() end
                end
            end
        end
        if model then
            CC.custom, CC.customFor = model, file
        else
            pcall(function()
                WindUI:Notify({ Title = "character changer", Content = "couldn't load " .. file, Duration = 4 })
            end)
        end
    end

    local function modelOf(who)
        if not who or who == "" then
            return tp.ent and tp.ent.Model, LocalPlayer.Name
        end
        local lower = who:lower()
        for _, e in pairs(Entities.GetAllCategoryEntities("Character")) do
            local pl = entPlayer(e)
            if pl and (pl.Name:lower() == lower or pl.DisplayName:lower() == lower) and e.Model then
                return e.Model, pl.Name
            end
        end
        return nil
    end

    local function saveCharacter(who)
        local char, owner = modelOf(who)
        if not char then
            return false, (who == "" or not who) and "turn Third Person on first (your body only exists then)" or "player not found"
        end
        if type(saveinstance) ~= "function" then return false, "no saveinstance" end

        undressAll()
        for _, d in ipairs(char:GetDescendants()) do pcall(function() d.Archivable = true end) end
        char.Archivable = true
        local copy = char:Clone()
        if not copy then return false, "could not clone" end
        for _, d in ipairs(copy:GetDescendants()) do
            if d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("BillboardGui") or d:IsA("Highlight") then
                d:Destroy()
            elseif d:IsA("BasePart") then
                d.Anchored = true
            end
        end
        local dir = CUSTOM_DIRS[1]
        local highest = 0
        pcall(function()
            if not isfolder("zaml") then makefolder("zaml") end
            if not isfolder(dir) then makefolder(dir) end
            for _, path in ipairs(listfiles(dir)) do
                local n = tonumber((path:match("([^/\\]+)$") or ""):match("^(%d+)%.rbxmx?$"))
                if n and n > highest then highest = n end
            end
        end)
        local name = tostring(highest + 1)
        copy.Name = name
        local temp = "zt_charsave_" .. tostring(math.random(100000, 999999))
        task.spawn(function()
            local ok = pcall(saveinstance, copy, { FileName = temp, mode = "model" })
            local written
            local deadline = os.clock() + 30
            while ok and os.clock() < deadline and not written do
                for _, ext in ipairs({ ".rbxmx", ".rbxm" }) do
                    if isfile(temp .. ext) then written = temp .. ext end
                end
                if not written then task.wait(0.25) end
            end
            local msg = "Saving failed"
            if written then

                local last, stable = -1, 0
                while stable < 3 do
                    local okR, data = pcall(readfile, written)
                    local size = okR and #data or -1
                    if size == last and size > 0 then stable = stable + 1 else stable = 0 end
                    last = size
                    task.wait(0.2)
                end
                pcall(function()
                    writefile(dir .. "/" .. name .. written:match("%.%w+$"), readfile(written))
                    delfile(written)
                end)
                msg = "Saved " .. tostring(owner) .. " as " .. name .. written:match("%.%w+$") .. " in " .. dir
            end
            pcall(function() copy:Destroy() end)
            elevate()
            pcall(function() WindUI:Notify({ Title = "character changer", Content = msg, Duration = 5 }) end)
            if CC.refreshFiles then pcall(CC.refreshFiles) end
        end)
        return true
    end

    local function wantsSelf()
        return CC.target == "Self" or CC.target == "Everyone"
    end
    local function wantsOther(enemy)
        if CC.target == "Everyone" then return true end
        return (CC.target == "Enemies" and enemy) or (CC.target == "Teammates" and not enemy)
    end

    hub.onUnload(undressAll)

    local remembered = {}
    local lastPass = 0
    local function passNow() lastPass = 0 end

    function tp.onBody(ent)
        if CC.on and wantsSelf() and ent.Model and template() then
            pcall(dress, ent.Model, ent.CurrentWeaponModel)
        end
    end
    function tp.onRemove(ent)
        if ent.Model then undress(ent.Model) end
    end
    do
        local conn = Entities.OnEntityCreated:Connect(function(kind, id, ent)
            if hub.unloaded or kind ~= "Character" or type(ent) ~= "table" or not ent.Model then return end
            if CC.on and template() and wantsOther(isEnemy(ent)) and not dressed[ent.Model] then
                remembered[id] = true
                pcall(dress, ent.Model, ent.CurrentWeaponModel)
            end
        end)
        hub.onUnload(function()
            tp.onBody, tp.onRemove = nil, nil
            pcall(function() if conn and conn.Disconnect then conn:Disconnect() end end)
        end)
    end

    for _, name in ipairs(agentNames) do agentTemplate(name) end
    hub.connect(RunService.Heartbeat, function()
        local now = os.clock()
        if now - lastPass < 0.3 then return end
        lastPass = now
        if not (CC.on and template()) then
            if next(dressed) then undressAll() end
            return
        end

        local live = {}
        local function consider(model, keep)
            if not (model and model:IsDescendantOf(workspace) and model:FindFirstChild("UpperTorso")) then return end
            live[model] = true
            local d = dressed[model]
            if d and (d.key ~= sourceKey() or not d.overlay.Parent) then
                undress(model)
                d = nil
            end
            if not d then
                pcall(dress, model, keep)
            else

                d.keep = keep
                hideRig(model, d)
            end
        end

        for id, e in pairs(Entities.GetAllCategoryEntities("Character")) do
            if alive(e) then
                local want = wantsOther(isEnemy(e))
                remembered[id] = want
                if want then consider(e.Model, e.CurrentWeaponModel) end
            end
        end
        local char = localChar()
        if char then remembered[char.Simulation.Identifier] = wantsSelf() end
        if tp.ent and tp.ent.Model and wantsSelf() then
            consider(tp.ent.Model, tp.ent.CurrentWeaponModel)
        end
        local ragdolls = workspace:FindFirstChild("Ragdolls")
        if ragdolls then
            for _, m in ipairs(ragdolls:GetChildren()) do
                if m:IsA("Model") and remembered[tonumber(m.Name)] then consider(m, nil) end
            end
        end
        for model in pairs(dressed) do
            if not live[model] then undress(model) end
        end
    end)

