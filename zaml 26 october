    hub.connect(UIS.InputBegan, function(input, gp)
        if capturing or UIS:GetFocusedTextBox() then return end
        if gp and input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        local kn = keyName(input)
        if not kn then return end
        for name, b in pairs(binds) do
            if b.key == kn and b.mode ~= "Always" then
                local reg = registry[name]
                if reg then
                    if b.mode == "Toggle" then
                        if reg.kind == "toggle" then reg.setState(not reg.isActive()) else reg.fire() end
                        refresh()
                    elseif b.mode == "Hold" then
                        heldKeys[name] = true
                        if reg.kind == "toggle" then reg.setState(true) else reg.fire() end
                        refresh()
                    end
                end
            end
        end
    end)
    hub.connect(UIS.InputEnded, function(input)
        local kn = keyName(input)
        if not kn then return end
        for name, b in pairs(binds) do
            if b.key == kn and b.mode == "Hold" and heldKeys[name] then
                heldKeys[name] = false
                local reg = registry[name]
                if reg and reg.kind == "toggle" then reg.setState(false) end
                refresh()
            end
        end
    end)

    local lastPoll = 0
    hub.connect(RunService.RenderStepped, function()
        if activePopup and (Window.Closed or Window.Destroyed) then
            if captureConn then captureConn:Disconnect(); captureConn = nil end
            pcall(function() activePopup:Destroy() end)
            activePopup = nil
        end
        for name, b in pairs(binds) do
            local reg = registry[name]
            if reg then
                if b.mode == "Always" then
                    if reg.kind == "toggle" then if reg.isActive and not reg.isActive() then reg.setState(true) end
                    elseif reg.fire then reg.fire() end
                elseif b.mode == "Hold" and heldKeys[name] and reg.kind == "button" and reg.fire then
                    reg.fire()
                end
            end
        end
        if os.clock() - lastPoll >= 0.3 then lastPoll = os.clock(); refresh() end
    end)

    bindManager = {}
    function bindManager.register(name, handle, opts)
        if type(handle) == "table" then
            if opts.auto then
                handle.__zbAuto = name
            elseif handle.__zbAuto and handle.__zbAuto ~= name then

                local old = handle.__zbAuto
                alias[old] = name
                registry[old] = nil
                for i = #order, 1, -1 do
                    if order[i] == old then table.remove(order, i) end
                end
            end
        end
        registry[name] = {
            frame = handle and handle.ElementFrame,
            kind = opts.kind, setState = opts.setState, isActive = opts.isActive,
            fire = opts.fire, title = opts.title or name,
        }
        order[#order + 1] = name
        if handle and handle.ElementFrame then
            local f = handle.ElementFrame
            hub.connect(f.MouseEnter, function() hoveredName = alias[name] or name end)
            hub.connect(f.MouseLeave, function()
                if hoveredName == name or hoveredName == alias[name] then hoveredName = nil end
            end)
        end
    end
    function bindManager.loadBinds()
        local loaded = {}
        pcall(function()
            local c = currentConfig or Config
            if c then
                local s = c:Get("zamlBinds")
                if s and s ~= "" then
                    local decoded = HttpService:JSONDecode(s)
                    if type(decoded) == "table" then loaded = decoded end
                end
            end
        end)
        binds = loaded
        table.clear(heldKeys)
        for name, b in pairs(binds) do
            if b.mode == "Always" then
                local reg = registry[name]
                if reg and reg.kind == "toggle" and reg.setState then reg.setState(true) end
            end
        end
        refresh()
    end
    function bindManager.refresh() refresh() end
    function bindManager.saveBinds(persist) saveBinds(persist) end
end)()

do
