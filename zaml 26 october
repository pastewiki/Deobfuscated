local function drawMarker(centre, mk, age)
    local t = math.clamp(age / S.hitTime, 0, 1)
    local alpha = t
    local color = mk.kill and S.killColor or S.hitColor
    local size = S.hitSize * (mk.kill and S.killScale or 1)
    local gap, rot = S.hitGap, 0
    if S.hitAnim == "Expand" then
        gap = gap + size * t
    elseif S.hitAnim == "Shrink" then
        size = size * (1 + (1 - math.min(t * 4, 1)) * 1.2)
    elseif S.hitAnim == "Spin" then
        rot = t * math.pi / 2
    end
    local thick = S.hitThick
    local function seg(a, b)
        if S.hitOutline then
            local d = (b - a)
            d = (d.Magnitude > 0) and d.Unit or Vector2.new(1, 0)
            draw.line(a - d, b + d, BLACK, thick + 2, alpha)
        end
        draw.line(a, b, color, thick, alpha)
    end
    local shape = S.hitShape
    if shape == "X" or shape == "Plus" then
        local base = (shape == "X") and math.pi / 4 or 0
        for k = 0, 3 do
            local a = base + rot + k * math.pi / 2
            local dir = Vector2.new(math.cos(a), math.sin(a))
            seg(centre + dir * gap, centre + dir * (gap + size))
        end
    else
        local n = (shape == "Square") and 4 or 24
        local r = size + gap
        local base = (shape == "Square") and math.pi / 4 or 0
        local prev
        for k = 0, n do
            local a = base + rot + k / n * math.pi * 2
            local pt = centre + Vector2.new(math.cos(a), math.sin(a)) * r
            if prev then seg(prev, pt) end
            prev = pt
        end
    end
    if S.hitDamage and mk.damage then
        draw.text(tostring(math.floor(mk.damage)), centre.X, centre.Y + gap + size + 4, color, 13, 0.5, alpha)
    end
end

local function renderHud(dt)
    local vp = Camera.ViewportSize
    local centre = vp / 2
    fpsSmooth = fpsSmooth + (1 / math.max(dt, 1e-4) - fpsSmooth) * 0.05

    local showCircle = S.silentAim and S.showFov and not S.rage
    if fovCircle.Visible ~= showCircle then fovCircle.Visible = showCircle end
    if showCircle then
        fovCircle.Size = UDim2.fromOffset(S.fov * 2, S.fov * 2)
        fovRing.Color = S.fovColor
    end

    if S.xhair then
        local g, l, t = S.xhairGap, S.xhairLen, S.xhairThick
        local arms = { { 1, 0 }, { -1, 0 }, { 0, 1 } }
        if not S.xhairT then arms[#arms + 1] = { 0, -1 } end
        for _, d in ipairs(arms) do
            local dir = Vector2.new(d[1], d[2])
            local a, b = centre + dir * g, centre + dir * (g + l)
            if S.xhairOutline then draw.line(a - dir, b + dir, BLACK, t + 2, 0) end
            draw.line(a, b, S.xhairColor, t, 0)
        end
    end
    if S.dot then
        local sz = S.dotSize
        draw.rect(centre.X - sz / 2 - 1, centre.Y - sz / 2 - 1, sz + 2, sz + 2, BLACK, 0, 0)
        draw.rect(centre.X - sz / 2, centre.Y - sz / 2, sz, sz, S.dotColor, 0, 0)
    end

    local now = os.clock()
    for i = #markers, 1, -1 do
        local mk = markers[i]
        local age = now - mk.at
        if age > math.max(S.hitTime, 1) then
            table.remove(markers, i)
        else
            if S.hitMarker and age < S.hitTime then
                if S.hitWhere ~= "Where It Landed" or not mk.pos then drawMarker(centre, mk, age) end
                if S.hitWhere ~= "Crosshair" and mk.pos then
                    local sp, on = w2s(mk.pos + Vector3.new(0, S.hitRise * age / S.hitTime, 0))
                    if on then drawMarker(sp, mk, age) end
                end
            end
            if S.dmgNumbers and mk.pos then
                local sp, on = w2s(mk.pos + Vector3.new(0, 1 + age * 2, 0))
                if on then draw.text("-" .. tostring(math.floor(mk.damage)), sp.X, sp.Y, mk.kill and S.killColor or S.dmgColor, 15, 0.5, math.clamp(age, 0, 1)) end
            end
        end
    end

    local rageLive = S.rage and rageTarget.entity ~= nil and os.clock() - (rageTarget.at or 0) < 0.35
    if rageLive and S.targetIndicator and rageTarget.pos then
        local sp, on = w2s(rageTarget.pos)
        if on then
            draw.rect(sp.X - 4, sp.Y - 4, 8, 8, S.hudColor, 1, 1, 0)
            draw.text(string.format("%s  %d  %d%%", rageTarget.part or "", rageTarget.damage or 0, (rageTarget.chance or 1) * 100),
                sp.X, sp.Y + 8, S.hudColor, 12, 0.5, 0)
        end
    end

    if S.watermark then
        local ping = 0
        pcall(function() ping = math.floor(LocalPlayer:GetNetworkPing() * 1000) end)
        local text = string.format("zamltra  |  %s  |  %d fps  |  %d ms  |  %s", LocalPlayer.Name, fpsSmooth, ping, os.date("%H:%M:%S"))
        local w = #text * 7.2 + 20
        draw.rect(vp.X - w - 12, 8, w, 24, Color3.fromRGB(14, 14, 18), 0, 0.25)
        draw.rect(vp.X - w - 12, 8, w, 2, S.hudColor, 0, 0)
        draw.text(text, vp.X - 22, 13, WHITE, 13, 1, 0)
    end

    local char = localChar()
    local under = centre.Y + 34
    if S.speedHud and char then
        local v = char.Simulation.Velocity
        draw.text(string.format("%.1f", math.sqrt(v.X * v.X + v.Z * v.Z)), centre.X, under, S.hudColor, 15, 0.5, 0)
        under = under + 18
    end
    if S.indicators then
        local function line(text, on)
            draw.text(text, centre.X, under, on and S.hudColor or Color3.fromRGB(150, 150, 155), 13, 0.5, on and 0 or 0.4)
            under = under + 15
        end
        if S.rage then line("RAGE", rageLive) end
        if S.silentAim and not S.rage then line("SILENT", tickState.aim ~= nil) end
        if S.trigger then line("TRIGGER", char ~= nil) end
        if S.aa then line("AA", char ~= nil) end
        if S.noRecoil then line("NO RECOIL", true) end
        if S.noSpread then line("NO SPREAD", true) end
        if S.bhop then line("BHOP", char ~= nil) end
        if S.tp then line("3RD", tp.active) end
    end
    if S.hudArrows and S.aa then
        local dim = Color3.fromRGB(120, 120, 125)
        local function arrow(dir, lit)
            local c = centre + dir * 46
            local side = Vector2.new(-dir.Y, dir.X)
            local tip, l, r = c + dir * 10, c + side * 7, c - side * 7
            local col = lit and S.hudColor or dim
            local alpha = lit and 0 or 0.45
            draw.line(tip, l, col, 2, alpha); draw.line(tip, r, col, 2, alpha); draw.line(l, r, col, 2, alpha)
        end
        arrow(Vector2.new(-1, 0), S.aaLeft or (not S.aaRight and S.aaYaw == "Left"))
        arrow(Vector2.new(1, 0), S.aaRight or (not S.aaLeft and S.aaYaw == "Right"))
        arrow(Vector2.new(0, 1), S.aaYaw == "Backward" or S.aaYaw == "Jitter" or S.aaYaw == "Spin")
    end

    pend.expire(now)
    if S.hitLogs then
        local y = centre.Y + 70
        for _, entry in ipairs(hitLog.entries) do
            local age = now - entry.at
            if age < 5 then
                draw.text(entry.text, centre.X, y, entry.color, 13, 0.5, math.clamp(age - 4, 0, 1))
                y = y + 16
            end
        end
    end

end

local function renderItems()
    local camPos = Camera.CFrame.Position
    if S.drops then
        for _, d in pairs(Entities.GetAllCategoryEntities("DroppedWeapon")) do
            local pos = d.Position
            if pos and not d.FogCulled then
                local dist = (pos - camPos).Magnitude
                if dist <= S.dropDist then
                    local sp, on = w2s(pos + Vector3.new(0, 0.6, 0))
                    if on then
                        local c4 = d.Name == "C4"
                        draw.text(string.format("%s  %dm", tostring(d.Name), dist * 0.28), sp.X, sp.Y,
                            c4 and Color3.fromRGB(255, 80, 80) or S.dropColor, 12, 0.5, 0)
                    end
                end
            end
        end
    end
    if S.bomb then
        for _, b in pairs(Entities.GetAllCategoryEntities("Bomb")) do
            local timer = b.BlowTimer
            if timer and timer > 0 and not b.Exploded and not b.Defused then
                local vp = Camera.ViewportSize
                local total = GameCfg.Get("Bomb", "BlowTimer") or 40
                local frac = math.clamp(timer / total, 0, 1)
                local color = timer < 10 and Color3.fromRGB(255, 70, 70) or Color3.fromRGB(255, 200, 90)
                local w = 260
                draw.rect(vp.X / 2 - w / 2 - 1, 43, w + 2, 6, Color3.new(0, 0, 0), 0, 0.4)
                draw.rect(vp.X / 2 - w / 2, 44, w * frac, 4, color, 0, 0)
                draw.text(string.format("C4  %.1fs%s", timer, b.Defusing and "  (defusing)" or ""), vp.X / 2, 52, color, 14, 0.5, 0)
                local pos = b.Position or (b.Model and b.Model:GetPivot().Position)
                if pos then
                    local sp, on = w2s(pos + Vector3.new(0, 1, 0))
                    if on then draw.text(string.format("C4 %.1f", timer), sp.X, sp.Y, color, 13, 0.5, 0) end
                end
            end
        end
    end
end

