local function screenDist(pos)
    local eye = CamCtl.GetAppliedCFrame()
    local lp = eye:PointToObjectSpace(pos)
    if lp.Z >= -0.05 then return math.huge end
    local half = Camera.ViewportSize.Y / 2
    local scale = half / math.tan(math.rad(Camera.FieldOfView) / 2)
    return math.sqrt(lp.X * lp.X + lp.Y * lp.Y) / -lp.Z * scale
end

function hub.aimPoint(e, name, mode)
    local part = e.Model and e.Model:FindFirstChild(name)
    if not part then return nil end
    local cf = part.CFrame
    if e.Culled then cf = e.CFrame * e.PrimaryPart.CFrame:ToObjectSpace(part.CFrame) end
    if mode ~= "Random" and mode ~= "Closest to Crosshair" then return cf.Position end
    local h = part.Size * 0.3
    if mode == "Random" then
        return cf:PointToWorldSpace(Vector3.new((math.random() * 2 - 1) * h.X, (math.random() * 2 - 1) * h.Y, (math.random() * 2 - 1) * h.Z))
    end
    local eye = CamCtl.GetAppliedCFrame()
    local o, d = eye.Position, eye.LookVector
    local t = math.max((cf.Position - o):Dot(d), 0)
    local lp = cf:PointToObjectSpace(o + d * t)
    return cf:PointToWorldSpace(Vector3.new(math.clamp(lp.X, -h.X, h.X), math.clamp(lp.Y, -h.Y, h.Y), math.clamp(lp.Z, -h.Z, h.Z)))
end

local ALL_PARTS = {
    "Head", "UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm",
    "RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot",
}
local HEAD_ONLY, BODY_ONLY = { "Head" }, { "UpperTorso" }
local legitLast = { at = 0 }

local function legitTarget(origin)
    local names = (S.aimPart == "Head") and HEAD_ONLY or (S.aimPart == "Body") and BODY_ONLY or ALL_PARTS
    local penWeapon = S.trigger and S.triggerPen and WC.GetCurrentWeapon() or nil
    if penWeapon and not (next(penWeapon) and penWeapon.Data) then penWeapon = nil end
    local now = os.clock()
    local last = (now - legitLast.at < 0.5) and legitLast or nil
    local best, held
    local mode = S.aimPoint
    if S.aimPart == "Closest to Crosshair" and mode == "Center" then mode = "Closest to Crosshair" end
    for _, e in pairs(Entities.GetAllCategoryEntities("Character")) do
        if targetable(e) and (not S.teamCheck or isEnemy(e)) then
            for _, name in ipairs(names) do
                local pos = (mode == "Closest to Crosshair") and hub.aimPoint(e, name, mode) or partPos(e, name)
                if pos then
                    local d = screenDist(pos)
                    if d <= S.fov then
                        local isHeld = last ~= nil and last.entity == e and last.part == name
                        if (isHeld or not best or d < best.d) and (not S.wallCheck or visible(origin, pos)
                            or (penWeapon and bulletDamage(penWeapon, origin, pos, name, true) > 0)) then
                            local cand = { entity = e, pos = pos, part = name, d = d }
                            if isHeld then held = cand end
                            if not best or d < best.d then best = cand end
                        end
                    end
                end
            end
        end
    end

    local pick = best
    if held and best and best ~= held and not (best.d < held.d * 0.6 or held.d - best.d > 25) then
        pick = held
    end
    if not pick then return nil end
    legitLast = { entity = pick.entity, part = pick.part, at = now }
    if mode == "Random" then
        local rp = hub.aimPoint(pick.entity, pick.part, "Random")
        if rp and (not S.wallCheck or visible(origin, rp)) then return pick.entity, rp, pick.part end
    end
    return pick.entity, pick.pos, pick.part
end

local rageTarget = { entity = nil, pos = nil, part = nil, damage = 0, renderTime = nil }

local rageScan
do
local POINTS = {
    Head = { Vector3.new(0, 0.75, 0), Vector3.new(-1, 0.2, 0), Vector3.new(1, 0.2, 0), Vector3.new(0, -0.5, 0) },
    Body = { Vector3.new(-1, 0, 0), Vector3.new(1, 0, 0), Vector3.new(0, 1, 0), Vector3.new(0, -1, 0) },
}
local function partBox(e, name)
    local part = e.Model:FindFirstChild(name)
    if not part then return nil end
    local cf = part.CFrame
    if e.Culled then cf = e.CFrame * e.PrimaryPart.CFrame:ToObjectSpace(part.CFrame) end
    return cf, part.Size / 2
end

local rageLastId
function rageScan(origin, weapon, camLook)
    local best, bestScore
    local maxCos = math.cos(math.rad(math.min(S.rageFov, 180)))

    local cone = 0
    pcall(function()
        local char = localChar()
        cone = weapon:GetInaccuracy(char.Simulation) + weapon:GetSpread()
    end)
    local need0 = S.dmgOverride and S.minDamageOverride or S.minDamage
    local names = HITBOX_SETS[S.rageHitbox] or HITBOX_SETS.Head
    local scale = S.multipoint and math.clamp(S.pointScale / 100, 0, 0.95) or 0

    local list = {}
    for _, e in pairs(Entities.GetAllCategoryEntities("Character")) do
        if targetable(e) and isEnemy(e) then
            local to = e.Position - origin
            local dist = to.Magnitude
            if dist <= S.maxDist and dist > 0.1 then
                local dot = camLook:Dot(to / dist)
                if S.rageFov >= 180 or dot >= maxCos then
                    list[#list + 1] = { e = e, dist = dist, dot = (e.Identifier == rageLastId) and 2 or dot }
                end
            end
        end
    end
    table.sort(list, function(x, y) return x.dot > y.dot end)

    for i, it in ipairs(list) do
        if i > 6 then break end
        local e, dist = it.e, it.dist
        local hp = e.Health
        local need = math.min(need0, hp)
        local pick, bodyLethal

        local function consider(name, pos, sizeFactor)
            local raw = bulletDamage(weapon, origin, pos, name, S.autowall)
            if raw <= 0 then return nil end
            local dmg = afterArmor(e, weapon, raw, name)
            if dmg < need then return nil end

            local reach = (S.rageNoSpread and 0 or cone) * (pos - origin).Magnitude
            local size = ((name == "Head") and 0.55 or 0.9) * sizeFactor
            local chance = (reach <= size) and 1 or size / reach
            local cand = { entity = e, pos = pos, part = name, damage = dmg,
                chance = chance, ready = chance * 100 >= S.hitChance }
            if not pick or (cand.ready and not pick.ready)
                or (cand.ready == pick.ready and dmg > pick.damage + 0.5) then
                pick = cand
            end
            if name ~= "Head" and dmg >= hp and (cand.ready or not (bodyLethal and bodyLethal.ready)) then
                bodyLethal = cand
            end
            return cand
        end

        for _, name in ipairs(names) do
            local cf, half = partBox(e, name)
            if cf then
                local centre = consider(name, cf.Position, 1)

                local full = centre and centre.ready and centre.damage >= hp
                if scale > 0 and not full then

                    local s2 = scale * ((name == "Head") and 0.5 or 0.75)
                    for _, dir in ipairs(POINTS[name == "Head" and "Head" or "Body"]) do
                        local local_ = Vector3.new(dir.X * half.X, dir.Y * half.Y, 0) * s2
                        consider(name, cf:PointToWorldSpace(local_), 1 - s2 * 0.6)
                    end
                end

                if pick and pick.ready and pick.damage >= hp and name == "Head" then break end
            end
        end
        if S.preferBody and bodyLethal and pick and (bodyLethal.ready or not pick.ready) then pick = bodyLethal end

        if pick then
            local score
            if S.rageSelect == "Distance" then score = dist
            elseif S.rageSelect == "Lowest HP" then score = hp
            elseif S.rageSelect == "Highest Damage" then score = -pick.damage
            else score = -camLook:Dot((pick.pos - origin).Unit) end

            if pick.ready then score = score - 1e6 end
            if not bestScore or score < bestScore then best, bestScore = pick, score end
        end
    end
    rageLastId = best and best.entity.Identifier or nil
    return best
end
end

local trigParams = RaycastParams.new()
trigParams.FilterType = Enum.RaycastFilterType.Include
local trigSince
local function triggerHit(origin, dir, range, weapon)
    local chars = workspace:FindFirstChild("Characters")
    if not chars or not refreshMap() then return false end
    local pen = S.triggerPen and weapon ~= nil

    trigParams.FilterDescendantsInstances = pen and { chars } or { mapGeometry, chars }
    local r = workspace:Raycast(origin, dir * range, trigParams)
    if not r or not r.Instance:IsDescendantOf(chars) then return false end
    local model = r.Instance
    while model and model.Parent ~= chars do model = model.Parent end
    local e = model and Entities.GetEntity("Character", tonumber(model.Name))
    if not (e ~= nil and targetable(e) and (not S.teamCheck or isEnemy(e))) then return false end
    if not weapon then return true end
    local need = trigNeed(e, weapon, origin, r.Position, r.Instance.Name)
    if not pen and need <= 0 then return true end
    local raw = bulletDamage(weapon, origin, r.Position, r.Instance.Name, pen)
    if raw <= 0 then return false end
    return afterArmor(e, weapon, raw, r.Instance.Name) >= need
end

