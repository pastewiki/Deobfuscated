        local accent = themed("Primary", Color3.fromRGB(129, 140, 248))
        local element = themed("ElementBackground", Color3.fromRGB(30, 30, 38))
        local hover = themed("ElementBackgroundHover", element:Lerp(WHITE, 0.06))
