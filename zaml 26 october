        local a, sz = obj.AbsolutePosition, obj.AbsoluteSize
        return p.X >= a.X and p.X <= a.X + sz.X and p.Y >= a.Y and p.Y <= a.Y + sz.Y
    end

    local Creator = WindUI.Creator
