        end
    end)
    local function before()
        if hub.unloaded or not (S.noRecoil or S.noShake) then return end
        if S.noShake and shakes then table.clear(shakes) end
        local char = localChar()
        local sim = char and char.Simulation
        if not sim then return end
        local prev = char.PreviousSimulation
        held = { sim = sim, a = sim.AimPunchAngle, av = sim.AimPunchAngleVel, v = sim.ViewPunchAngle,
                 prev = prev, pg = prev and prev.OnGround }
        sim.AimPunchAngle, sim.AimPunchAngleVel = Vector3.zero, Vector3.zero
        sim.ViewPunchAngle = Vector3.zero

        if prev and S.noShake then prev.OnGround = sim.OnGround end
    end
    local function after()
        local h = held
        if not h then return end
        held = nil
        h.sim.AimPunchAngle, h.sim.AimPunchAngleVel, h.sim.ViewPunchAngle = h.a, h.av, h.v
        if h.prev then h.prev.OnGround = h.pg end
    end
    local pre = M.Tick.PostTick.Connect({ Priority = 3, SubPriority = 0.5, Function = function()
        local ok = pcall(before)
        if not ok then pcall(after) end
    end })
    local post = M.Tick.PostTick.Connect({ Priority = 3, SubPriority = 1.5, Function = function() pcall(after) end })
    hub.onUnload(function()
        pcall(pre.Disconnect)
        pcall(post.Disconnect)
        pcall(after)
    end)
end

