    local WeaponManager = M.WeaponManager
    local NAME = { HE = "HE Grenade", Flash = "Flashbang", Smoke = "Smoke Grenade", Molotov = "Molotov",
                   Incendiary = "Incendiary Grenade", Decoy = "Decoy Grenade" }
    local SHORT = { HE = "HE", Flash = "FLASH", Smoke = "SMOKE", Molotov = "MOLLY", Incendiary = "INC", Decoy = "DECOY" }
    local DANGER = Color3.fromRGB(255, 55, 55)
