    local shaped = {}
    function bindManager.shapeTab(tab, tabTitle)
        if type(tab) ~= "table" or shaped[tab] then return tab end
        local st = { col = 1, weight = { 0, 0 }, order = 0, heads = {}, current = nil }
        local map = GENERAL[string.lower(tostring(tabTitle))]

        local function place(group, m, frame, handle)
            local prev = group.prev
            if m == "Colorpicker" and prev and prev.m == "Toggle" and not prev.merged then
                if mergeSwatch(prev.frame, handle, frame) then
                    prev.merged = true
                    frame.Parent = group.frame
                    return
                end
            end
            if m ~= "Divider" and m ~= "Space" then
                addToGroup(group, frame, st.order)
            else
                frame.LayoutOrder = st.order
                frame.Parent = group.frame
            end
            group.prev = { m = m, frame = frame }
        end
        shaped[tab] = st

        local function columns()
            if st.cols then return st.cols end
            local container = tab.UIElements and tab.UIElements.ContainerFrame
            if not container then return nil end
            local list = container:FindFirstChildOfClass("UIListLayout")
            if not list then return nil end
            local gap = list.Padding

            local holder = Instance.new("Frame")
            holder.Name = "ZbColumns"
            holder.BackgroundTransparency = 1
            holder.Size = UDim2.new(1, 0, 0, 0)
            holder.AutomaticSize = Enum.AutomaticSize.Y
            holder.LayoutOrder = -1
            holder.Parent = container
            local row = Instance.new("UIListLayout")
            row.FillDirection = Enum.FillDirection.Horizontal
            row.SortOrder = Enum.SortOrder.LayoutOrder
            row.Padding = UDim.new(0, 10)
            row.Parent = holder

            local cols = {}
            for i = 1, 2 do
                local c = Instance.new("Frame")
                c.Name = "Column" .. i
                c.BackgroundTransparency = 1
                c.AutomaticSize = Enum.AutomaticSize.Y
                c.LayoutOrder = i
                c.Parent = holder
                local l = Instance.new("UIListLayout")
                l.SortOrder = Enum.SortOrder.LayoutOrder
                l.Padding = gap
                l.Parent = c
                cols[i] = c
            end

            local narrow
            local function fit()
                local now = container.AbsoluteSize.X < NARROW
                if now == narrow then return end
                narrow = now
                row.FillDirection = now and Enum.FillDirection.Vertical or Enum.FillDirection.Horizontal
                for i = 1, 2 do
                    cols[i].Size = now and UDim2.new(1, 0, 0, 0) or UDim2.new(0.5, -5, 0, 0)
                end
            end
            fit()
            hub.connect(container:GetPropertyChangedSignal("AbsoluteSize"), fit)

            st.cols = cols
            return cols
        end

        for _, m in ipairs(METHODS) do
            local orig = tab[m]
            if type(orig) == "function" then
                tab[m] = function(self, cfg, ...)
                    local isCfg = type(cfg) == "table"
                    local desc
                    if isCfg and INFO[m] and type(cfg.Desc) == "string" and cfg.Desc ~= "" then
                        desc = cfg.Desc
                        cfg.Desc = nil
                    end

                    local state, userCb = false, isCfg and cfg.Callback or nil
                    if isCfg and m == "Toggle" then
                        state = cfg.Value == true
                        cfg.Callback = function(v, ...)
                            state = v == true
                            if userCb then return userCb(v, ...) end
                        end
                    end

                    local handle = orig(self, cfg, ...)
                    local frame = type(handle) == "table" and handle.ElementFrame

                    hub.breathe()
                    if typeof(frame) ~= "Instance" then return handle end

                    local cols = columns()
                    if cols and not map then

                        st.order = st.order + 2
                        if m == "Section" then
                            st.col = (st.weight[2] < st.weight[1]) and 2 or 1
                            st.weight[st.col] = st.weight[st.col] + 1
                            frame.LayoutOrder = st.order
                            frame.Parent = cols[st.col]
                            pcall(captionSection, frame)
                            st.current = nil
                        else
                            if not st.current then
                                st.order = st.order + 2
                                st.current = newGroup(cols[st.col], st.order)
                                st.order = st.order + 2
                            end
                            st.weight[st.col] = st.weight[st.col] + (WEIGHT[m] or 1)
                            place(st.current, m, frame, handle)
                        end
                    elseif cols then
                        st.order = st.order + 2
                        if m == "Section" then

                            local title = isCfg and type(cfg.Title) == "string" and cfg.Title or "Section"
                            local gname = map[string.lower(title)] or title
                            local head = st.heads[gname]
                            if not head then
                                local col = (st.weight[2] < st.weight[1]) and 2 or 1
                                frame.LayoutOrder = st.order
                                frame.Parent = cols[col]

                                pcall(function()
                                    for _, d in ipairs(frame:GetDescendants()) do
                                        if d:IsA("TextLabel") and d.Text ~= "" then d.Text = gname break end
                                    end
                                end)
                                pcall(captionSection, frame)
                                st.order = st.order + 2
                                head = { col = col, card = newGroup(cols[col], st.order) }
                                st.heads[gname] = head
                                st.weight[col] = st.weight[col] + 1
                            else
                                frame.Visible = false
                                frame.Parent = head.card.frame
                            end
                            local popup, group = newPopup(title)
                            st.order = st.order + 2
                            newSubRow(head.card, rowName(title), popup, st.order)
                            st.weight[head.col] = st.weight[head.col] + 1
                            st.current = group
                        elseif st.current then
                            place(st.current, m, frame, handle)
                        else

                            st.col = (st.weight[2] < st.weight[1]) and 2 or 1
                            st.weight[st.col] = st.weight[st.col] + (WEIGHT[m] or 1)
                            st.loose = st.loose or {}
                            local g = st.loose[st.col]
                            if not g then
                                g = newGroup(cols[st.col], st.order)
                                st.loose[st.col] = g
                                st.order = st.order + 2
                            end
                            place(g, m, frame, handle)
                        end
                    end

                    if desc and not addInfo(frame, desc) then
                        pcall(function() handle:SetDesc(desc) end)
                    end

                    if m == "Colorpicker" and isCfg and type(userCb) == "function" and type(handle.Update) == "function" then
                        local origUpdate = handle.Update
                        handle.Update = function(self, color, transparency, ...)
                            local r = origUpdate(self, color, transparency, ...)
                            if typeof(color) == "Color3" then pcall(userCb, color, transparency) end
                            return r
                        end
                    end

                    if isCfg and type(cfg.Title) == "string" and (m == "Toggle" or m == "Button") then
                        local key = "auto:" .. (type(cfg.Flag) == "string" and cfg.Flag
                            or (tostring(tabTitle) .. "/" .. cfg.Title))
                        if m == "Toggle" then
                            bindManager.register(key, handle, {
                                auto = true, kind = "toggle", title = cfg.Title,
                                isActive = function() return state end,
                                setState = function(on)
                                    pcall(function() handle:Set(on) end)
                                    if state ~= on then cfg.Callback(on) end
                                end,
                            })
                        elseif type(userCb) == "function" then
                            bindManager.register(key, handle, {
                                auto = true, kind = "button", title = cfg.Title,
                                fire = function() userCb() end,
                            })
                        end
                    end
                    return handle
                end
            end
        end
        return tab
    end

