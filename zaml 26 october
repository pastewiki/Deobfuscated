    local weapon = WC.GetCurrentWeapon()
    if not weapon or not next(weapon) then return end
    local eye = eyePos(sim) + (sim.Velocity or Vector3.zero) * dt
    local kickNext = predictPunch(sim, dt)

    local fireNow = canFire(weapon, sim, dt, char)
    tickState.postRuns = (tickState.postRuns or 0) + 1
    if tickState.aim then tickState.aimTicks = (tickState.aimTicks or 0) + 1 end
    local held = userFiring()
    local want = false

    if tickState.aim and tickState.aim.knife and not held then
        WC.UpdateKeyState(tickState.aim.knife, true)
        tickState.knifeDown = tickState.aim.knife
    end

    if isGun(weapon) and fireNow then
        local aim = tickState.aim
        local camLook = anglesCF(-tickState.camPitch, tickState.camYaw).LookVector
        local dir

        if aim then
            dir = (aim.pos - eye).Unit
            want = tickState.aimHold or held or tickState.trigSilentWant
        elseif S.noRecoil or S.noSpread or S.trigger then
            dir = camLook
        end

        if S.trigger and not aim and not S.rage then
            local scale = recoilScale()
            local kick = kickNext
            local shotCF = S.noRecoil and anglesCF(-tickState.camPitch, tickState.camYaw)
                or anglesCF(-tickState.camPitch + math.rad(kick.X * scale), tickState.camYaw + math.rad(kick.Y * scale))
            local shot = shotCF.LookVector
            if triggerHit(eye, shot, weapon.Data.Range or 300, weapon) then
                trigSince = trigSince or os.clock()
                if os.clock() - trigSince >= S.triggerDelay / 1000 then want = true end
            else
                trigSince = nil
            end
        end

        local firing = want or held or WC.GetKeyState("WishFire") == true or (tickState.fireHold or 0) > 0
            or (weapon.BurstFireRemaining or 0) > 0
        if dir and firing and (aim or S.noRecoil or S.noSpread) then
            local comp = S.noRecoil or (aim and S.rage and S.rageRecoil) or (aim and not S.rage)
            local punch = comp and kickNext or nil
            local sx, sy = 0, 0
            tickState.shotGuard = nil
            if S.noSpread or (aim and S.rage and S.rageNoSpread) then
                sx, sy = nextSpread(char, weapon, dt)
                tickState.pred = { sx, sy }
                if aim and aim.entity and S.spreadGuard then
                    local origin = eye
                    local point = guardedPoint(aim.entity, origin, dir, sx, sy,
                        (not S.rage) and aim.part or nil, (not S.rage) and aim.pos or nil)
                    if point then
                        dir = (point - origin).Unit
                        tickState.shotGuard = true
                    else
                        tickState.shotGuard = false
                    end
                end
            else
                tickState.pred = nil
            end
            local yaw, pitch
            if punch then
                yaw, pitch = solveAngles(dir, punch, sx, sy)
            else

                yaw, pitch = solveAngles(dir, Vector3.zero, sx, sy)
            end

            local qy, qp = quantize(yaw, pitch)
            if not saved.angles then
                local y0, p0 = CamCtl.GetAngles()
                saved.angles = { y0, p0 }
            end
            local y, pch = dequantize(qy, qp)
            CamCtl.SetAngles(wrap(y + math.pi / 65535), math.min(pch + PITCH_MAX / 65535, PITCH_MAX))
        end
    end

    if S.rage and S.autoScope and tickState.rageSeen and weapon.IsSniper and (weapon.ZoomLevel or 0) == 0
        and not weapon.Reloading and not weapon.Equipping then
        tickState.scopePulse = not tickState.scopePulse
        WC.UpdateKeyState("WishFire2", tickState.scopePulse)
        tickState.scoping = true
    elseif tickState.scoping then
        tickState.scoping, tickState.scopePulse = false, false
        WC.UpdateKeyState("WishFire2", UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) and not menuBlocked())
    end

    if S.autoReload and isGun(weapon) and not weapon.Reloading and not tickState.aim then
        local d = weapon.Data
        if d.Ammo <= S.reloadAt and d.Ammo < d.ClipSize and (d.ReserveAmmo or 0) > 0 and not held then
            WC.UpdateKeyState("WishReload", true)
            tickState.forcedReload = true
        end
    elseif tickState.forcedReload then
        tickState.forcedReload = false
        WC.UpdateKeyState("WishReload", false)
    end

    if want and not held and tickState.forcedFire and isGun(weapon) and weapon.Data.Automatic ~= false then
        tickState.fireRelease = 0
    end
    if want and not held and (tickState.fireHold or 0) <= 0 and (tickState.fireRelease or 0) <= 0 then
        tickState.forcedShots = (tickState.forcedShots or 0) + 1
        tickState.lastRageShot = os.clock()
        tickState.fireHold = 1
    end
    if (tickState.fireHold or 0) > 0 then
        tickState.fireHold = tickState.fireHold - 1
        WC.UpdateKeyState("WishFire", true)
        tickState.forcedFire = true
        if tickState.fireHold == 0 then tickState.fireRelease = 1 end
    else
        if tickState.forcedFire then
            tickState.forcedFire = false
            WC.UpdateKeyState("WishFire", held)
        end
        if (tickState.fireRelease or 0) > 0 then tickState.fireRelease = tickState.fireRelease - 1 end
    end
end

function restoreInputs(char)
    if saved.angles then
        pcall(CamCtl.SetAngles, saved.angles[1], saved.angles[2])
        saved.angles = nil
    end
    if saved.move then
        if char then char.Left, char.Right, char.Forward, char.Backward = saved.move[1], saved.move[2], saved.move[3], saved.move[4] end
        saved.move = nil
    end
    if saved.jump ~= nil then
        if char then char.Jump = saved.jump end
        saved.jump = nil
    end
    if saved.duck ~= nil then
        if char then char.Duck = saved.duck end
        saved.duck = nil
    end
end

local function preTick(dt)
    local char = localChar()
    restoreInputs(char)
    tickState.aim = nil
    tickState.trigSilentWant = false
    tickState.pred = nil
    tickState.rageSeen = false
    tickState.preRuns = (tickState.preRuns or 0) + 1
    if not char or menuBlocked() then return end

    local qy, qp = CamCtl.GetMapAngles()
    local mx = (char.Left or 0) + (char.Right or 0)
    local mz = (char.Forward or 0) + (char.Backward or 0)
    local t = math.sqrt(mx * mx + mz * mz) * 0.3826834
    local f0, b0, l0, r0 = mz < -t, mz > t, mx < -t, mx > t
    local j0, d0 = char.Jump == true, char.Duck == true
    local cmd = {
        Yaw = qy, Pitch = qp, ClientTick = M.Tick.GetTick(),
        Inputs = { Forward = f0, Backward = b0, Left = l0, Right = r0 },
        AdditionalInputs = { Jump = j0, Duck = d0, Walk = char.Walk == true, PressE = char.PressE == true },
    }
    createMove(char, cmd)

    if cmd.Yaw ~= qy or cmd.Pitch ~= qp then
        local y0, p0 = CamCtl.GetAngles()
        saved.angles = { y0, p0 }
        local cw = tickState.camWrite
        if cw then

            saved.angles = { wrap(cw[1]), math.clamp(cw[2], -PITCH_MAX, PITCH_MAX) }
        end

        local y, pch = dequantize(cmd.Yaw, cmd.Pitch)
        CamCtl.SetAngles(wrap(y + math.pi / 65535), math.min(pch + PITCH_MAX / 65535, PITCH_MAX))
    end
    local inp, add = cmd.Inputs, cmd.AdditionalInputs
    if inp.Forward ~= f0 or inp.Backward ~= b0 or inp.Left ~= l0 or inp.Right ~= r0 then
        saved.move = { char.Left, char.Right, char.Forward, char.Backward }
        char.Left, char.Right = inp.Left and -1 or 0, inp.Right and 1 or 0
        char.Forward, char.Backward = inp.Forward and -1 or 0, inp.Backward and 1 or 0
    end
    if (add.Jump == true) ~= j0 then
        saved.jump = char.Jump
        char.Jump = add.Jump == true
    end
    if (add.Duck == true) ~= d0 then
        saved.duck = char.Duck
        char.Duck = add.Duck == true
    end
end

