local tracerHue = 0
local function drawTracer(weapon, origin, finish, hitSomething)
    local start = origin
    if S.tracerFrom == "Gun" then
        local muzzle = weapon.Viewmodel and weapon.Viewmodel:FindFirstChild("Muzzle", true)
        start = (muzzle and muzzle:IsA("BasePart")) and muzzle.Position
            or (CamCtl.GetAppliedCFrame() * Vector3.new(0.35, -0.35, -1.5))
    end
    local color = tracerColor
    if S.tracerRainbow then
        tracerHue = (tracerHue + 0.07) % 1
        color = Color3.fromHSV(tracerHue, 0.85, 1)
    end
    local life, width = S.tracerLife, S.tracerWidth
    local len = (finish - start).Magnitude

    if S.tracer and len > 0.5 then
        if S.tracerStyle == "Beam" then

            local holder = Instance.new("Part")
            holder.Anchored, holder.CanCollide, holder.CanQuery, holder.CanTouch = true, false, false, false
            holder.Transparency, holder.Size, holder.CFrame = 1, Vector3.new(0.1, 0.1, 0.1), CFrame.new(start)
            holder.Parent = fxFolder
            local a0 = Instance.new("Attachment", holder)
            local a1 = Instance.new("Attachment", holder)
            a1.WorldPosition = finish
            local beam = Instance.new("Beam")
            beam.Attachment0, beam.Attachment1 = a0, a1
            beam.Width0, beam.Width1 = width * 2.5, width * 0.6
            beam.FaceCamera = true
            beam.LightEmission, beam.LightInfluence = 1, 0
            beam.Color = ColorSequence.new(color)
            beam.Parent = holder
            task.spawn(function()
                local t0 = os.clock()
                while holder.Parent and os.clock() - t0 < life do
                    local k = (os.clock() - t0) / life
                    beam.Transparency = NumberSequence.new(k * 0.9, math.min(1, 0.3 + k))
                    task.wait(0.03)
                end
                holder:Destroy()
            end)
        elseif S.tracerStyle == "Lightning" then

            local steps = math.clamp(math.floor(len / 4), 4, 14)
            local dir = (finish - start).Unit
            local side = dir:Cross(Vector3.new(0, 1, 0))
            if side.Magnitude < 1e-3 then side = Vector3.new(1, 0, 0) end
            side = side.Unit
            local up = side:Cross(dir).Unit
            local prev = start
            for i = 1, steps do
                local p = start + (finish - start) * (i / steps)
                if i < steps then
                    p = p + side * (math.random() - 0.5) * 0.9 + up * (math.random() - 0.5) * 0.9
                end
                local seg = (p - prev).Magnitude
                if seg > 0.05 then
                    fxPart(Vector3.new(width, width, seg), CFrame.lookAt((prev + p) / 2, p), color, life)
                end
                prev = p
            end
        else
            fxPart(Vector3.new(width, width, len), CFrame.lookAt((start + finish) / 2, finish), color, life)
        end
    end

    if S.impact and hitSomething then
        local size = S.impactSize
        local dotPart = fxPart(Vector3.new(size, size, size), CFrame.new(finish), impactColor, life)
        if S.impactGlow then
            local light = Instance.new("PointLight")
            light.Color, light.Range, light.Brightness = impactColor, 6, 2
            light.Parent = dotPart
        end
    end
end

local gameShot = { at = 0 }
local function applyGame(shot, gs)
    if not shot or not gs or gs.applied == shot then return end
    if math.abs((shot.at or 0) - gs.at) > 0.15 then return end
    gs.applied = shot
    if gs.endPos then
        shot.gameEnd = gs.endPos
        tickState.gameEnds = (tickState.gameEnds or 0) + 1
        if shot.pos and (gs.endPos - shot.pos).Magnitude > 1 then tickState.gameEndsFurther = (tickState.gameEndsFurther or 0) + 1 end
    end
    for id, v in pairs(gs.hits or {}) do
        local e = Entities.GetEntity("Character", id)
        if e and isEnemy(e) then
            local first = (type(v) == "table" and v[1]) or v
            local obj = type(first) == "table" and first.Object
            local partName = obj and (typeof(obj) == "Instance" or type(obj) == "table") and obj.Name or nil
            if not shot.entity then shot.entity, shot.part = e, partName end
            local uid = e.UserId
            shot.pendUsers = shot.pendUsers or {}
            if uid and not shot.pendUsers[uid] and (e.Health or 0) > 0 then
                shot.pendUsers[uid] = true
                tickState.wallAttrib = (tickState.wallAttrib or 0) + 1
                pend.list[#pend.list + 1] = {
                    userId = uid, name = entName(e), part = pend.part(partName) or "body",
                    deadline = shot.at + pend.window(),
                }
            end
        end
    end
end
local function freshGameShot()
    if os.clock() - gameShot.at > 0.05 then gameShot = { at = os.clock() } end
    return gameShot
end
