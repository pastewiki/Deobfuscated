    local function showPopup(name)
        if activePopup then pcall(function() activePopup:Destroy() end); activePopup = nil end
        if captureConn then captureConn:Disconnect(); captureConn = nil end
        capturing = false
        local reg = registry[name]
        local target = reg and reg.frame
        if typeof(target) ~= "Instance" then return end

        local text = themed("Text", WHITE)
