local function canFire(weapon, sim, dt, char)
    if not isGun(weapon) or sim.Preparation or sim.Defusing or sim.Planting then return false end
    local d = weapon.Data
    if weapon.Equipping or weapon.Reloading then return false end
    if (d.Ammo or 0) <= 0 then return false end

    if (weapon.BurstFireRemaining or 0) > 0 then return true end
    if weapon.WaitForNoAttack then return false end
    if d.Automatic == false and weapon.WannaShoot then return false end
    return ((char and char.WeaponTimer) or weapon.Timer or 0) + dt >= weapon.FireDelay - 1e-5
end

