                part.Material, part.Color = o.mat, o.color
                if part.Transparency < 1 then part.Transparency = o.transp end
                if o.tex then part.TextureID = o.tex end
                if o.sa then o.sa.Parent = part end
            end)
        end
        table.clear(saved)
    end
    local last = 0
    hub.connect(RunService.RenderStepped, function()
        if not S.vmChams then
            if next(saved) then restore() end
            return
        end
        if os.clock() - last < 0.2 then return end
        last = os.clock()
        local weapon = WC.GetCurrentWeapon()
        local vm = (weapon and next(weapon) and weapon.Viewmodel) or Camera:FindFirstChild("Viewmodel")
        if not (vm and vm.Parent) then return end
        local material = Enum.Material[S.vmMaterial] or Enum.Material.ForceField
        for _, d in ipairs(vm:GetDescendants()) do
            if d:IsA("BasePart") then
                local o = saved[d]
                if not o and d.Transparency < 1 then
                    o = { mat = d.Material, color = d.Color, transp = d.Transparency }
                    if d:IsA("MeshPart") then o.tex = d.TextureID end
                    saved[d] = o
                end
                if o then
                    pcall(function()

                        local sa = d:FindFirstChildOfClass("SurfaceAppearance")
                        if sa then
                            o.sa = sa
                            sa.Parent = nil
                        end
                        if d:IsA("MeshPart") and d.TextureID ~= "" then
                            o.tex = d.TextureID
                            d.TextureID = ""
                        end
                        d.Material, d.Color = material, S.vmColor
                        if d.Transparency < 1 then d.Transparency = math.max(o.transp, S.vmTransparency) end
                    end)
                end
            end
        end
        for part in pairs(saved) do
            if not part.Parent then saved[part] = nil end
        end
    end)
    hub.onUnload(restore)
